<!--p id="notice"><%= notice %></p-->

<h1>Wallets</h1>

<table class="table table=hover">
  <thead class="table-dark bg-dark">
    <tr>
      <th>User</th>
      <th>Currency</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @wallets.each do |wallet| %>
      <tr>
        <td><%= wallet.user_id %></td>
        <td><%= wallet.currency %></td>
        <td>
          <%= link_to "visibility", wallet, class: "material-icons btn btn-primary btn-xs", title: "View Wallet" %>
          <%= link_to "edit_note", edit_wallet_path(wallet), class: "material-icons btn btn-success btn-xs", title: "Edit Wallet" %>
          <%= link_to "delete", wallet, method: :delete, data: { confirm: "Are you sure?" }, class: "material-icons btn btn-danger btn-xs", title: "Delete Wallet" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New Wallet", new_wallet_path, class: "btn btn-primary btn-sm my-3" %>
