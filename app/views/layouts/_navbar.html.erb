<div class="sidebar-menu">
  <div class="sidebar-menu-inner">
    <header class="logo-env">
      <div class="sidebar-mobile-menu visible-xs"> <a href="#" class="with-animation"> <i
                                class="material-icons">menu</i> </a> </div>
    </header>

    <div class="sidebar-user-info">
      <div class="sui-normal"> <a href="#" class="user-link">
          <% my_account = my_account %>
          <% if my_account.present? %>
            <% if my_account.image.attached? %>
              <%= image_tag my_account.image.variant(resize: "500x500"), width: "70", alt: "", style: "border-radius: 10px;" %>
            <% else %>
              <img class="img rounded" src="assets/Default-avatar.jpg" alt="" />
            <% end %>
            <span>Welcome,</span>
            <strong><%= my_account.first_name %></strong> </a>
        <% end %>
      </div>
      <div class="sui-hover inline-links animate-in">
        <%= link_to groups_path, class: "nav-link" do %>
          <i class="material-icons">dashboard</i>
          Groups
        <% end %>
        <%= link_to wallets_path, class: "nav-link" do %>
          <i class="material-icons">account_balance_wallet</i>
          Wallets
        <% end %>

        <% if my_account.present? %>
          <%= link_to account_path(Account.where(user_id: current_user.id).last.id), class: "nav-link", method: :get do %>
            <i class="material-icons">manage_accounts</i>
            Account
          <% end %>
        <% end %>
        <span class="close-sui-popup">×</span>
      </div>
    </div>

    <ul id="main-menu" class="main-menu">
      <li>
        <%= link_to dashboard_path, class: "nav-link" do %>
          <i class="material-icons">dashboard</i>
          <span class="title">Dashboard</span>
        <% end %>
      </li>
      <li class="has-sub
      <% if controller_name == "groups" || controller_name == "members" || controller_name == "projects" || controller_name == "loans" || controller_name == "assets" || controller_name == "liabilities" || controller_name == "groups" || action_name == "contributions" %>
      opened
      <% end %>
      ">
        <%= link_to groups_path, class: "nav-link" do %>
          <i class="material-icons">groups</i>
          <span class="title">
            Group
            <% if session[:current_group] %>
              (<%= Group.find(session[:current_group]).name %>)
            <% end %>
          </span>
        <% end %>
        <ul>
          <% if session[:current_group] %>
            <li>
              <%= link_to group_path(session[:current_group]), class: "nav-link" do %>
                <i class="material-icons">text_snippet</i><span class="title">Overview</span>
              <% end %>
            </li>
          <% end %>
          <li>
            <%= link_to members_path, class: "nav-link" do %>
              <i class="material-icons">group</i><span class="title">Members</span>
            <% end %>
          </li>
          <li>
            <%= link_to contributions_path, class: "nav-link" do %>
              <i class="material-icons">savings</i><span class="title">Savings & Contributions</span>
            <% end %>
          </li>
          <li>
            <%= link_to projects_path, class: "nav-link" do %>
              <i class="material-icons">business_center</i><span class="title">Projects</span>
            <% end %>
          </li>
          <li>
            <%= link_to loans_path, class: "nav-link" do %>
              <i class="material-icons">credit_score</i><span class="title">Loans</span>
            <% end %>
          </li>
          <li>
            <%= link_to group_assets_path, class: "nav-link" do %>
              <i class="material-icons">maps_home_work</i><span class="title">Assets</span>
            <% end %>
          </li>
          <li>
            <%= link_to liabilities_path, class: "nav-link" do %>
              <i class="material-icons">money_off_csred</i><span class="title">Liabilities</span>
            <% end %>
          </li>
        </ul>
      </li>
      <li class="has-sub <% if controller_name == "wallets" %>opened<% end %>">
        <%= link_to wallets_path, class: "nav-link" do %>
          <i class="material-icons">account_balance_wallet</i>
          <span class="title">Wallets</span>
        <% end %>
        <ul>
          <li>
            <% Wallet.mine(current_user.id).map do |wallet| %>
              <%= link_to wallet_path(wallet.id), class: "nav-link" do %>
                <img src="assets/flags/<%= wallet.currency[0...2].downcase %>.svg" style="width: 30px;"/>
                <span class="title"><%= wallet.currency.upcase %></span>
              <% end %>
            <% end %>
          </li>
        </ul>
      </li>
    </ul>
  </div>
</div>
