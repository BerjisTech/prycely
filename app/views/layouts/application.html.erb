      <meta content="@prycely_finance" name="twitter:site">
      <meta content="https://assets.prycely.com/images/d6f18dcdfc48ef9c283fa8e68a5c7a9e.png" name="twitter:image:src">
      <link href="https://assets.prycely.com/images/d6f18dcdfc48ef9c283fa8e68a5c7a9e.png" rel="icon" type="image/png">
      <% if (controller_name != "home") %>
        <%= render "/layouts/header" %>
        <%= stylesheet_link_tag "application", media: "all", 'data-turbolinks-track': "reload" %>
        <%= javascript_pack_tag "application", 'data-turbolinks-track': "reload" %>
      <% else %>
        <%= render "/home/header" %>
      <% end %>
