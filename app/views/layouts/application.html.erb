      <%= render 'layouts/constants' %>
      <% if user_signed_in? && controller_name != 'home' %>
        <%= render 'layouts/nav' %>
        <%= render 'layouts/account_bar' %>
        <div class="main-content">
          <%- if action_name == 'show' %>
            <%= yield %>
          <% else%>
            <div class="row">
              <div class="col-sm-1"></div>
              <div class="col-sm-10">
                <%= yield %>
              </div>
              <div class="col-sm-1"></div>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= yield %>
        <%= render "/home/footer" %>
      <% end %>
