<script>
  document.querySelector('.prycely_to_navbar').remove()
</script>
<hr />
Hello There,
<%= @invite.first_name %> has invited you to join <%= @invite.name %>. 
<% if @invite.description != "" %>
  <%= @invite.name %> Is a <%= @grouptype %> group that <% @invite.description %>
<% end %>

<% if user_signed_in? %>
  <% session[:current_id] = @invite.group_id %>
  <%= link_to "Join "+@invite.name, new_member_path, class: "btn btn-outline-primary" %>
<% else %>
  <%= link_to "Create Account and Join "+@invite.name, new_user_registration_path, class: "btn btn-outline-primary" %>
<% end %>
