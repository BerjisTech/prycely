<% loan_category = Loancategory.find(@loan.loan_type) %>
<% loan = @loan %>
<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="mt-4 MB-2">
      <span class="fs-3">
        <%= link_to loan_category.name, @loan.loan_type %>
      </span>
    </div>
    <div class="row">
      <div class="col-sm-8">
        <div class="p-2 bg-white shadow rounded border">
          <%= render 'form', loan_payment: @loan_payment %>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="p-2 bg-white shadow rounded border">
          <span>Loan Details</span>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>
