<div class="p-3">
  <h6 class="text-uppercase">Payment details</h6>
  <div class="form-floating mt-3">
    <input type="text" name="name" class="form-control" required="required" placeholder="Placeholder">
    <label>Name on card</label> </div>
  <div class="row">
    <div class="col-md-6">
      <div class="form-floating mt-3 mr-2">
        <input type="text" name="name" class="form-control" required="required" placeholder="Placeholder">
        <i class="material-icons">credit_card</i>
        <label>Card Number</label> </div>
    </div>
    <div class="col-md-6">
      <div class="d-flex flex-row">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="name" class="form-control" required="required" placeholder="Placeholder">
          <label>Expiry</label>
        </div>
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="name" class="form-control" required="required" placeholder="Placeholder">
          <label>CVV</label>
        </div>
      </div>
    </div>
  </div>
  <div class="mt-4 mb-4">
    <h6 class="text-uppercase">Billing Address</h6>
    <div class="row mt-3">
      <div class="col-md-6">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="name" class="form-control" required="required" placeholder="Placeholder">
          <label>Street Address</label>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="name" class="form-control" required="required" placeholder="Placeholder">
          <label>City</label>
        </div>
      </div>
    </div>
    <div class="row mt-2">
      <div class="col-md-6">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="name" class="form-control" required="required" placeholder="Placeholder">
          <label>State/Province</label>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="name" class="form-control" required="required" placeholder="Placeholder">
          <label>Zip code</label>
        </div>
      </div>
    </div>
  </div>
</div>
