<div class="p-3 card_reusable">
  <h6 class="text-uppercase">Payment details</h6>
  <div class="form-floating mt-3">
    <input type="text" name="card[holder_name]" class="form-control" placeholder="Placeholder">
    <label>Name on card</label>
  </div>
  <div class="row">
    <div class="col-md-6">
      <div class="form-floating mt-3 mr-2">
        <input type="text" name="card[card_number]" class="form-control" placeholder="Placeholder">
        <i class="material-icons">credit_card</i>
        <label>Card Number</label>
      </div>
    </div>
    <div class="col-md-6">
      <div class="d-flex flex-row">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="card[expiry]" class="form-control" placeholder="Placeholder">
          <label>Expiry</label>
        </div>
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="card[cvv]" class="form-control" placeholder="Placeholder">
          <label>CVV</label>
        </div>
      </div>
    </div>
  </div>
  <div class="mt-4 mb-4">
    <h6 class="text-uppercase">Billing Address</h6>
    <div class="row mt-3">
      <div class="col-md-6">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="card[street_address]" class="form-control" placeholder="Placeholder">
          <label>Street Address</label>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="card[city]" class="form-control" placeholder="Placeholder">
          <label>City</label>
        </div>
      </div>
    </div>
    <div class="row mt-2">
      <div class="col-md-6">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="card[province" class="form-control" placeholder="Placeholder">
          <label>State/Province</label>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mt-3 mr-2 form-floating">
          <input type="text" name="card[zip_code" class="form-control" placeholder="Placeholder">
          <label>Zip code</label>
        </div>
      </div>
    </div>
  </div>
</div>
