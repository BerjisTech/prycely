<script>
  const loan_pay_currency = "<%= Money::Currency.find(@group.currency).symbol %>"
  let amount = <%= @loan.amount_due %>
</script>
<%= form_with(model: loan_payment) do |form| %>
  <% if loan_payment.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(loan_payment.errors.count, "error") %> prohibited this loan_payment from being saved:</h2>

      <ul>
        <% loan_payment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :group_id, value: @group.id %>
  <%= form.hidden_field :user_id, value: @loan.user_id %>
  <%= form.hidden_field :loan_id, value: @loan.id %>

  <div class="px-3">
    <div class="field form-floating">
      <%= form.number_field :amount, class: "form-control", step: "0.001", placeholder: "Placeholder" %>
      <%= form.label :amount %>
    </div>
  </div>
  <div class="px-3">
    <div class="field form-group">
      <%= form.label :payment_method %>
      <%= form.select :payment_method, options_for_select(["", "Card", "Mpesa", "Manual"]), {}, class: "form-control select2", placeholder: "Placeholder" %>
    </div>
  </div>

  <%= render '/loan_payments/reusables/card' %>
  <%= render '/loan_payments/reusables/mpesa' %>
  <%= render '/loan_payments/reusables/manual' %>

  <div class="mt-4 mb-4 d-flex justify-content-between p-3"> <span>Previous step</span> <%= form.submit "Pay #{Money::Currency.find(@group.currency).symbol} #{number_with_precision(@loan.amount_due, precision: 2, delimiter: ',')}", class: "btn btn-primary pay_submit"%></div>

<% end %>
