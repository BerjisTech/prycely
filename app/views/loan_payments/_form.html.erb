<%= form_with(model: loan_payment) do |form| %>
  <% if loan_payment.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(loan_payment.errors.count, "error") %> prohibited this loan_payment from being saved:</h2>

      <ul>
        <% loan_payment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :group_id, value: @group_id %>
  <%= form.hidden_field :user_id, value: @user_id %>
  <%= form.hidden_field :loan_id, value: @loan_id %>
  
  <div class="field">
    <%= form.label :amount %>
    <%= form.text_field :amount %>
  </div>
  <div class="field">
    <%= form.label :payment_method %>
    <%= form.select :payment_method, options_for_select(["card", "mpesa"]), {}, class: "form-control select2"%>
  </div>
  <div class="field">
    <%= form.label :amount %>
    <%= form.text_field :amount %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
