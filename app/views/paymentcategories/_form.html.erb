<%= form_with(model: paymentcategory) do |form| %>
  <% if paymentcategory.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(paymentcategory.errors.count, "error") %> prohibited this paymentcategory from being saved:</h2>
      <ul>
        <% paymentcategory.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :group_id, value: session[:active_group] %>
  <%= form.hidden_field :created_by, value: current_user.id %>

  <div class="field form-floating my-2">
    <%= form.select :payment_category_type, options_for_select([['Income','1'], ['expense','2']]), {}, class: "form-control", placeholder: "Placeholder" %>
    <%= form.label :payment_category_type %>
  </div>
  <div class="field form-floating my-2">
    <%= form.text_field :name, class: "form-control", placeholder: "Placeholder" %>
    <%= form.label :name %>
  </div>
  <div class="actions my-2">
    <%= form.submit class: "btn btn-md btn-primary" %>
  </div>
<% end %>
