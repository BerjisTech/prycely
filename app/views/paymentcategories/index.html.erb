<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="bg-white rounded border shadow p-3">
      <div class="d-flex align-items-center justify-content-between">
        <span class="fs-3 fw-lighter">Payment Categories for <%= @group.name.humanize %></span>
        <%= link_to "New Payment Category", new_paymentcategory_path %>
      </div>
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Group</th>
            <th>Created by</th>
            <th>Type</th>
            <th>Name</th>
          </tr>
        </thead>
        <tbody>
          <% @paymentcategories.each do |paymentcategory| %>
            <tr>
              <td><%= Group.find(paymentcategory.group_id).name.humanize %></td>
              <td><%= Account.full_names(paymentcategory.created_by) %></td>
              <td><%= Paymentcategory.category_name[paymentcategory.payment_category_type].humanize %></td>
              <td><%= paymentcategory.name %></td>
              <td><% link_to "Show", paymentcategory %></td>
              <td><% link_to "Edit", edit_paymentcategory_path(paymentcategory) %></td>
              <td><% link_to "Destroy", paymentcategory, method: :delete, data: { confirm: "Are you sure?" } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>
