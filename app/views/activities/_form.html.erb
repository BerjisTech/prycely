<%= form_with(model: activity) do |form| %>
  <% if activity.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(activity.errors.count, "error") %> prohibited this activity from being saved:</h2>

      <ul>
        <% activity.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :group_id, value: @group.id %>
  <%= form.hidden_field :created_by, value: current_user.id %>

  <div class="row">
    <div class="col-sm-6">

      <div class="field form-floating my-2">
        <%= form.text_field :title, class: "form-control", placeholder: "Placeholder" %>
        <%= form.label :title %>
      </div>

      <div class="field form-floating my-2">
        <%= form.date_field :date, value: Date.today, class: "form-control", placeholder: "Placeholder" %>
        <%= form.label :date %>
      </div>

      <div class="row">
        <div class="col-sm-6">
          <div class="field form-floating my-2">
            <%= form.number_field :price, class: "form-control", placeholder: "Placeholder" %>
            <%= form.label :price %>
          </div>
        </div>

        <div class="col-sm-6">
          <div class="field form-floating my-2">
            <%= form.number_field :fine, class: "form-control", placeholder: "Placeholder" %>
            <%= form.label :fine %>
          </div>
        </div>
      </div>

      <div class="field form-floating my-2">
        <%= form.text_field :host, class: "form-control", placeholder: "Placeholder" %>
        <%= form.label :host %>
      </div>

      <div class="field form-group my-2">
        <%= form.label :host_contact %>
        <%= form.rich_text_area :host_contact %>
      </div>

    </div>

    <div class="col-sm-6">
      <div class="field form-group activity_description_field_block">
        <%= form.label :description %>
        <%= form.rich_text_area :description %>
      </div>
    </div>

  </div>

  <div class="actions">
    <%= form.submit "Create Activity", class: "btn btn-primary my-2"%>
  </div>
<% end %>

<style>
  .activity_description_field_block trix-editor{
    min-height: 365px;
  }
</style>
