<p id="notice"><%= notice %></p>

<h1>Activities</h1>

<table class="table table-responsive table-hover">
  <thead class="table-dark bg-dark">
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Date</th>
      <th>Created by</th>
      <th>Group</th>
      <th>Price</th>
      <th>Fine</th>
      <th>Host</th>
      <th>Host contact</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @activities.each do |activity| %>
      <tr>
        <td><%= activity.title %></td>
        <td><%= activity.description %></td>
        <td><%= activity.date %></td>
        <td><%= activity.created_by %></td>
        <td><%= activity.group_id %></td>
        <td><%= activity.price %></td>
        <td><%= activity.fine %></td>
        <td><%= activity.host %></td>
        <td><%= activity.host_contact %></td>
        <td><%= link_to "Show", activity %></td>
        <td><%= link_to "Edit", edit_activity_path(activity) %></td>
        <td><%= link_to "Destroy", activity, method: :delete, data: { confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New Activity", new_activity_path %>
