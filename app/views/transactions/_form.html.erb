<%= form_with(model: transaction) do |form| %>
  <% if transaction.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(transaction.errors.count, "error") %> prohibited this transaction from being saved:</h2>

      <ul>
        <% transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <div class="col-sm-4">
      <div class="fs-2 mb-4">New Transaction</div>
      <div class="fs-3 fw-light">This is a manual transaction. You're ading it on behalf of a member. Make sure the funds have been received before you add the transaction to the database yto maintain accuracy of records.</div>
    </div>
    <div class="col-sm-8 bg-white shadow rounded-3 border">
      <div class="mx-3">
        <div class="field form-group my-4">
          <%= form.label 'Member' %>
          <%= form.select :user_id, options_from_collection_for_select(Member.for_group(params[:group_id]), :user_id, :full_names), { prompt: "Select Member"}, class: "form-control js-example-basic-single select2 select-2", placeholder: "Placeholder" %>
        </div>

        <div class="field form-floating my-4">
          <%= form.number_field :amount, class: "form-control", placeholder: "Placeholder" %>
          <%= form.label :amount %>
        </div>

        <%= form.hidden_field :transaction_reference, value: current_user.id %>
        <%= form.hidden_field :transaction_type, value: 1 %>
        <%= form.hidden_field :level, value: 1 %>
        <%= form.hidden_field :wallet_id, value: params[:group_id] %>
        <%= form.hidden_field :group_id, value: params[:group_id] %>
        <%= form.hidden_field :transaction_mode, value: 0 %>
        <%= form.hidden_field :status, value: 1 %>

        <div class="field form-floating my-4">
          <%= form.text_area :description, class: "form-control", placeholder: "Placeholder" %>
          <%= form.label :description %>
        </div>

        <div class="actions my-4 text-end">
          <%= form.submit "Create Transaction", class: "btn btn-lg btn-primary" %>
        </div>
      </div>
    </div>
  </div>

<% end %>
