<%= form_with(model: transaction) do |form| %>
  <% if transaction.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(transaction.errors.count, "error") %> prohibited this transaction from being saved:</h2>

      <ul>
        <% transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field form-group col-sm-12">
    <%= form.label :user_id %>
    <%= form.number_field :user_id %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :amount %>
    <%= form.text_field :amount %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :transaction_reference %>
    <%= form.text_area :transaction_reference %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :transaction_type %>
    <%= form.number_field :transaction_type %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :group_id %>
    <%= form.number_field :group_id %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :wallet_id %>
    <%= form.number_field :wallet_id %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :status %>
    <%= form.number_field :status %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :transaction_mode %>
    <%= form.number_field :transaction_mode %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :category %>
    <%= form.text_area :category %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :sub_category %>
    <%= form.text_area :sub_category %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
