<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <p>
      <strong>User:</strong>
      <%= Account.full_names(@transaction.user_id) %>
    </p>
    <p>
      <strong>Amount:</strong>
      <%= Transact.amount_from_cents(@transaction.amount) %>
    </p>
    <p>
      <strong>Transaction reference:</strong>
      <%= @transaction.transaction_reference %>
    </p>
    <p>
      <strong>Transaction type:</strong>
      <%= Paymentcategory.category_name[@transaction.transaction_type] %>
    </p>
    <p>
      <strong>Group:</strong>
      <%= Group.find(@transaction.group_id).name %>
    </p>
    <p>
      <strong>Wallet:</strong>
      <%= @transaction.wallet_id %>
    </p>
    <p>
      <strong>Status:</strong>
      <%= @transaction.status %>
    </p>
    <p>
      <strong>Transaction mode:</strong>
      <%= @transaction.transaction_mode %>
    </p>
    <p>
      <strong>Description:</strong>
      <%= @transaction.description %>
    </p>
    <p>
      <strong>Category:</strong>
      <%= Paymentcategory.find(@transaction.category).name %>
    </p>
    <p>
      <strong>Sub category:</strong>
      <%= @transaction.sub_category %>
    </p>
  </div>
  <div class="col-sm-1"></div>
</div>
<% link_to "Edit", edit_transaction_path(@transaction) %> |
<% link_to "Back", transactions_path %>
