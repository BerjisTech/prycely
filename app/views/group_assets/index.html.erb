<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="d-flex whole-width align-items-center justify-content-between">
      <span class="fs-3 my-3 py-3">My Groups' Assets</span>
      <% if Member.is_manager(current_user.id, @group.id) %>
        <div>
          <%= link_to 'Add Asset', new_group_asset_path, class: "btn btn-primary px-2" %>
        </div>
      <% end %>
    </div>
    <div class="bg-white shadow border rounded">
      <% if @group_assets.present? %>
        <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
          <span></span>
          <div>
            <input type="search" placeholder="Search for assets by date, amount, balance" class="form-control">
          </div>
        </div>
        <div class="group_projects">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Asset</th>
                <th>Added by</th>
                <th>Price</th>
                <th>Date bought</th>
                <% if Member.is_manager(current_user.id, @group.id) %>
                  <th colspan="3"></th>
                <% end %>
              </tr>
            </thead>

            <tbody>
              <% @group_assets.map do |asset| %>
                <tr>
                  <td><%= asset.name.humanize %></td>
                  <td><%= link_to Account.full_names(asset.user_id), asset.user_id %></td>
                  <td><%= Money::Currency.find(@group.currency).symbol %> <%= number_with_precision(asset.price, precision: 2, delimiter: ",") %></td>
                  <td><%= asset.date_bought.strftime("#{asset.date_bought.day.ordinalize} %b, %Y") %></td>
                  <% if Member.is_manager(current_user.id, @group.id) %>
                    <td><%= link_to "Show", asset %></td>
                    <td><%= link_to "Edit", edit_group_asset_path(asset) %></td>
                    <td><%= link_to "Destroy", asset, method: :delete, data: { confirm: "Are you sure?" } %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="m-4 p-4 d-flex align-items-center justify-content-center flex-column">
          <img src="depositphotos_423476202-stock-illustration-businessmen-unlighted-light-bulb-concept.jpg" style="width: 400px;" />
          You don't have any assets yet
          <%= link_to 'Add Asset', new_group_asset_path %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>
