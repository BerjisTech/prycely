<h1><%= @group_asset.name %></h1>

<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="row bg-white rounded border shadow p-4">
      <div class="col-sm-4">
        <p>
          <strong>Price:</strong>
          <%= Money::Currency.find(Group.find(@group_asset.group_id).currency).symbol%> <%= number_with_precision(@group_asset.price, precision: 2, delimiter: ",") %>
        </p>
        <% if @group_asset.date_bought.present? %>
          <p>
            <strong>Date bought:</strong>
            <%= @group_asset.date_bought.strftime("#{@group_asset.date_bought.day.ordinalize} %b, %Y") %>
          </p>
        <% else %>
          To be purchased.
        <% end %>

        <% if @group_asset.date_sold.present? %>
          <p>
            <strong>Date sold:</strong>
            <%= @group_asset.date_sold.strftime("#{@group_asset.date_sold.day.ordinalize} %b, %Y") %>
          </p>
        <% end %>
      </div>
      <div class="col-sm-8">
        <%= @group_asset.description %>
      </div>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>

<%= link_to 'Edit', edit_group_asset_path(@group_asset) %> |
<%= link_to 'Back', group_assets_path %>
