<div class="groups_holder">
  <% if @invites.empty? %>
    <div class="group justify-content-center align-items-center p-3">You currently have no invites</div>
  <% end %>
  <% @invites.each do |invite| %>
    <%= link_to group_path(invite.group_id), class: "group" do %>
      <span class="group_dp"><%= invite.name[0] %></span>
      <span class="group_name">
        <span><%= invite.name %></span>
        <sub><%= invite.currency %></sub>
      </span>
      <span><%= invite.currency %></span>
    <% end %>
  <% end %>
</div>
