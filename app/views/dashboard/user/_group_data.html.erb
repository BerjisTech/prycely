<div class="col-sm-6 user_groups">
  <div class="user_group_margin">
    <div class="groups_section_top">
      <span>My Groups (<%= @my_groups.count %>)</span>
      <%= link_to groups_path do %>All groups<em class="material-icons">chevron_right</em><% end %>
    </div>
    <div class="group_section_data">
      <div class="mrr_data">
        <div class="mrr_data_tab">
          <span class="material-icons">addchart</span>
          <div class="mrr_details">
            <span><%= Money::Currency.find(@account.default_currency).symbol %> <%= number_with_precision(@my_groups_numbers.credit, precision: 2, delimitor: ',', separator: '.') || 0.to_f %></span>
            <span>Deposits</span>
          </div>
        </div>
        <div class="mrr_data_tab">
          <span class="material-icons">groups</span>
          <div class="mrr_details">
            <span><%= Money::Currency.find(@account.default_currency).symbol %> <%= number_with_precision(@my_groups_numbers.debit, precision: 2, delimitor: ',', separator: '.') || 0.to_f %></span>
            <span>Withdrawals</span>
          </div>
        </div>
        <div class="mrr_data_tab">
          <span class="material-icons">group_add</span>
          <div class="mrr_details">
            <span><%= Money::Currency.find(@account.default_currency).symbol %> <%= number_with_precision(@my_groups_numbers.loans, precision: 2, delimitor: ',', separator: '.') || 0.to_f %></span>
            <span>Loans</span>
          </div>
        </div>
      </div>
      <div class="pie_chart">
        <%= render 'dashboard/charts/doughnut' %>
      </div>
    </div>
  </div>
</div>
