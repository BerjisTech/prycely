<%= render "js" %>
<div class="row">
  <div class="col-sm-9">
    <div class="row">
      <%= render "groups" %>
    </div>
    <div class="row">
      <%= render "charts" %>
    </div>
  </div>

  <div class="col-md-3">
    <div class="user_area">
      <span class="user_image">
        <%= image_tag @account.image.variant(resize: "500x500") %>
      </span>
      <span class="name_n_email">
        <span><%= "#{@account.first_name} #{@account.last_name}" %></span>
        <span><%= current_user.email %></span>
      </span>
    </div>
    <% if @wallets.empty? %>
      <div class="tile-title tile-orange" onclick="window.location.href='<%= new_wallet_path %>'" style="cursor: pointer;">
        <div class="icon">
          <i class="material-icons" style="font-size: 60px !important;">account_balance_wallet</i>
        </div>

        <div class="title">
          <h3>YOU HAVE NO WALLETS</h3>

          <p>Create one now</p>
        </div>
      </div>
    <% else %>
      <%= render "wallets" %>
      <%= link_to wallets_path, type: "button", class: "btn btn-blue btn-icon", style: "margin-top: 10px;" do %>
        View all wallets
        <i class="material-icons">east</i>
      <% end %>
    <% end %>
  </div>
</div>
