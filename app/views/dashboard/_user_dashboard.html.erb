<%= render "js" %>
<div class="row">
  <div class="col-sm-9">
    <div class="row">
      <%= render "groups" %>
      <div class="col-md-3 col-sm-6" onclick="window.location.href='/groups/1'">
        <div class="group">
          <div class="group_identity">
            <span class="group_dp">P</span>
            <span>Prycely</span>
          </div>

          <div class="group_amount_progress">
            <span><sub class="text-success">KES</sub> 2,215,215</span>
            <span class="sparkline_rise">2000,2300,1700,1500,3000,2700,3400</span>
          </div>

          <div class="group_currency_progress">
            <span>KES</span>
            <span>+3.25%</span>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6" onclick="window.location.href='/groups/1'">
        <div class="group">
          <div class="group_identity">
            <span class="group_dp">P</span>
            <span>Prycely</span>
          </div>

          <div class="group_amount_progress">
            <span><sub class="text-success">KES</sub> 2,215,215</span>
            <span class="sparkline_drop">3000,2700,3400,1500,1700,2300,2000</span>
          </div>

          <div class="group_currency_progress">
            <span>KES</span>
            <span>+3.25%</span>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6" onclick="window.location.href='/groups/1'">
        <div class="group">
          <div class="group_identity">
            <span class="group_dp">P</span>
            <span>Prycely</span>
          </div>

          <div class="group_amount_progress">
            <span><sub class="text-success">KES</sub> 2,215,215</span>
            <span class="sparkline_drop">3000,2700,3400,1500,1700,2300,2000</span>
          </div>

          <div class="group_currency_progress">
            <span>KES</span>
            <span>+3.25%</span>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4">
        My Group Invites
        <%= render "invites" %>
      </div>
      <div class="col-md-4">My Wallets</div>
    </div>
  </div>

  <div class="col-md-3">
    <% if @wallets.empty? %>
      <div class="tile-title tile-orange" onclick="window.location.href='<%= new_wallet_path %>'" style="cursor: pointer;">
        <div class="icon">
          <i class="material-icons" style="font-size: 60px !important;">account_balance_wallet</i>
        </div>

        <div class="title">
          <h3>YOU HAVE NO WALLETS</h3>

          <p>Create one now</p>
        </div>
      </div>
    <% else %>
      <%= render "wallets" %>
      <%= link_to wallets_path, type: "button", class: "btn btn-blue btn-icon" do %>
        View all wallets
        <i class="material-icons">east</i>
      <% end %>
    <% end %>
  </div>
</div>
