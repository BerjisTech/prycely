<!--p id="notice"><%= notice %></p-->

<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="d-flex whole-width align-items-center justify-content-between">
      <span class="fs-3 my-3 py-3">My Liabilities</span>
      <% if Member.is_manager(current_user.id, @group.id) %>
        <div>
          <%= link_to 'Add New Liability', new_liability_path, class: "btn btn-primary px-2" %>
        </div>
      <% end %>
    </div>
    <div class="bg-white shadow border rounded">
      <% if @liabilities.present? %>
        <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
          <span></span>
          <div>
            <input type="search" placeholder="Search for liabilities by date, amount, balance" class="form-control">
          </div>
        </div>
        <div class="group_projects">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Liability</th>
                <th>Added by</th>
                <th>Price</th>
                <th>Date bought</th>
                <% if Member.is_manager(current_user.id, @group.id) %>
                  <th colspan="3"></th>
                <% end %>
              </tr>
            </thead>

            <tbody>
              <% @liabilities.map do |liability| %>
                <tr>
                  <td><%= liability.name.humanize %></td>
                  <td><%= link_to Account.full_names(liability.added_by), liability.added_by %></td>
                  <td><%= Money::Currency.find(@group.currency).symbol %> <%= number_with_precision(liability.price, precision: 2, delimiter: ",") %></td>
                  <td><%= liability.date_bought.strftime("#{liability.date_bought.day.ordinalize} %b, %Y") %></td>
                  <% if Member.is_manager(current_user.id, @group.id) %>
                    <td><%= link_to "Show", liability %></td>
                    <td><%= link_to "Edit", edit_liability_path(liability) %></td>
                    <td><%= link_to "Destroy", liability, method: :delete, data: { confirm: "Are you sure?" } %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>

        </div>
      <% else %>
        <div class="m-4 p-4 d-flex align-items-center justify-content-center flex-column">
          <img src="https://assets.prycely.com/depositphotos_423476202-stock-illustration-businessmen-unlighted-light-bulb-concept.jpg" style="width: 400px;" />
          You haven't requested any liabilities yet
          <%= link_to 'Add new liability', new_liability_path %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>
