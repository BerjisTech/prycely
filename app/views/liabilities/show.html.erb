<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <h1><%= @liability.name %></h1>
    <div class="row bg-white rounded border shadow p-4 mb-2">
      <div class="col-sm-4">
        <p>
          <strong>Price:</strong>
          <%= Money::Currency.find(Group.find(@liability.group_id).currency).symbol%> <%= number_with_precision(@liability.price, precision: 2, delimiter: ",") %>
        </p>
        <% if @liability.date_bought.present? %>
          <p>
            <strong>Date bought:</strong>
            <%= @liability.date_bought.strftime("#{@liability.date_bought.day.ordinalize} %b, %Y") %>
          </p>
        <% else %>
          To be purchased.
        <% end %>

        <% if @liability.date_sold.present? %>
          <p>
            <strong>Date sold:</strong>
            <%= @liability.date_sold.strftime("#{@liability.date_sold.day.ordinalize} %b, %Y") %>
          </p>
        <% end %>
      </div>
      <div class="col-sm-8">
        <%= @liability.description %>
      </div>
    </div>
    <%= link_to 'Edit', edit_group_asset_path(@liability) %> |
    <%= link_to 'Back', liabilities_path %>
  </div>
  <div class="col-sm-1"></div>
</div>
