<%= form_with(model: liability) do |form| %>
  <% if liability.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(liability.errors.count, "error") %> prohibited this liability from being saved:</h2>

      <ul>
        <% liability.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field form-group col-sm-12">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :group_id %>
    <%= form.number_field :group_id %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :date_bought %>
    <%= form.datetime_select :date_bought %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :date_sold %>
    <%= form.datetime_select :date_sold %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :added_by %>
    <%= form.number_field :added_by %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :price %>
    <%= form.text_field :price %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
