<div class="col-12 panelCard payChoicePanel">
  <div class="col-sm-7">
    <div class="payChoice">
      <span class="entypo-left-thin ctdp-title" onclick="goToTopUp()"> Back</span>
      <a href='<%= "#{root_url}deposit/mpesa/#{@level}/#{@account}/#{@amount}/#{@origin}/#{@recepient}" %>' class="pc-mPesa">
        <span class="material-icons">security_update_good</span>
        <div class="payChoiceDescription">
          <span>MPESA</span>
          <span>Top up with your mPesa mobile account. Arrives immediately</span>
        </div>
        <span class="wd-checkbox material-icons">east</span>
      </a>
      <a href='<%= "#{root_url}deposit/bank/#{@level}/#{@account}/#{@amount}/#{@origin}/#{@recepient}" %>' class="pc-debitCard">
        <span class="material-icons">account_balance</span>
        <div class="payChoiceDescription">
          <span>Bank or Card</span>
          <span>Top up with your debit card. Arrives immediately</span>
        </div>
        <span class="wd-checkbox material-icons">east</span>
      </a>
      <a href='<%= "#{root_url}deposit/paypal/#{@level}/#{@account}/#{@amount}/#{@origin}/#{@recepient}" %>' class="pc-debitCard">
        <span class="material-icons">paypal</span>
        <div class="payChoiceDescription">
          <span>PayPal</span>
          <span>Top up directly from PayPal account</span>
        </div>
        <span class="wd-checkbox material-icons">east</span>
      </a>
    </div>
    <div class="confirmTransDetailsPanel">
    </div>
  </div>
  <div class="col-sm-5">
    <div class="tu-trans-details">
      <span>Details</span>
      <div class="bd bdPay">
        <span class="breakDownTitle">You will pay</span>
        <span class="breakDownValue"></span>
      </div>
      <div class="bd bdFee">
        <span class="breakDownTitle">Total Fees</span>
        <span class="breakDownValue"></span>
      </div>
      <div class="bd bdConvert">
        <span class="breakDownTitle">Amount we'll convert</span>
        <span class="breakDownValue"></span>
      </div>
      <div class="bd bdRate">
        <span class="breakDownTitle">Guaranteed rate (for 20 hours)</span>
        <span class="breakDownValue"></span>
      </div>
    </div>
  </div>
</div>
<%= render "transact/deposit/js" %>
<script>
  get_conversion('<%= @origin %>', '<%= @recepient %>', '<%= @amount %>')
</script>
