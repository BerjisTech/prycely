<p id="notice"><%= notice %></p>

<h1>Requests</h1>

<table class="table table-bordered datatable" id="datatable">
  <thead>
    <tr>
      <th>Group</th>
      <th>User</th>
      <th>Account</th>
      <th>Emai</th>
      <th>Accept</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @requests.each do |request| %>
      <tr>
        <td><%= request.group_id %></td>
        <td><%= request.user_id %></td>
        <td><%= request.account_id %></td>
        <td><%= request.emai %></td>
        <td><%= request.accept %></td>
        <td><%= link_to "Show", request %></td>
        <td><%= link_to "Edit", edit_request_path(request) %></td>
        <td><%= link_to "Destroy", request, method: :delete, data: { confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New Request", new_request_path %>
