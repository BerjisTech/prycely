<%= form_with(model: loancategory) do |form| %>
  <% if loancategory.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(loancategory.errors.count, "error") %> prohibited this loancategory from being saved:</h2>

      <ul>
        <% loancategory.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <%= form.hidden_field :group_id, value: session[:current_group] %>
    <%= form.hidden_field :created_by, value: current_user.id %>

    <div class="col-sm-6">
      <div class="field my-2 form-floating">
        <%= form.text_field :name, placeholder: "Placeholder", class: "form-control" %>
        <%= form.label 'Name eg Emergency Loan'.humanize %>
      </div>

      <div class="field my-2 form-floating">
        <%= form.number_field :period, placeholder: "Placeholder", class: "form-control" %>
        <%= form.label 'Period in Months' %>
      </div>

      <div class="row">
        <div class="col-6">
          <div class="field field my-2 form-floating">
            <%= form.select( :pegged_to, ['nothing', 'balance', 'total user and guarantor balance'] , {}, {placeholder: "Placeholder", class: "form-control" } )%>
            <%= form.label :pegged_to %>
            <small>What is this looan tied to?</small>
          </div>
        </div>
        <div class="col-6">
          <div class="field my-2 form-floating">
            <%= form.text_field :amount, placeholder: "Placeholder", class: "form-control" %>
            <%= form.label :amount %>
            <small>Max loan amount eg 3x (for 3 times user balance) or 600000</small>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-6">
          <div class="field my-2 form-floating">
            <%= form.number_field :interest, placeholder: "Placeholder", class: "form-control" %>
            <%= form.label 'Interest (%)' %>
          </div>
        </div>
        <div class="col-6">
          <div class="field field my-2 form-floating">
            <%= form.select( :interest_rule, ['fixed rate', 'per month', 'per annum', 'reducing balance', 'per day'] , {}, {placeholder: "Placeholder", class: "form-control" } )%>
            <%= form.label :interest_rule %>
          </div>
        </div>
      </div>

      <div class="field my-2 form-floating">
        <%= form.number_field :required_guarantos, placeholder: "Placeholder", class: "form-control" %>
        <%= form.label 'Number of required guarantors' %>
      </div>
    </div>
    <div class="col-sm-6">
      <div class="row">
        <div class="col-sm-6">
          <div class="field my-2 form-floating">
            <%= form.number_field :membership_durantion_requirement, placeholder: "Placeholder", class: "form-control" %>
            <%= form.label :membership_durantion_requirement %>
            <small>How many months do members have to be active before accessing this loan?</small>
          </div>
        </div>
        <div class="col-sm-6">
          <div class="field my-2 form-floating">
            <%= form.number_field :approvals, placeholder: "Placeholder", class: "form-control" %>
            <%= form.label :approvals %>
            <small>How many signatories are required to approve this loan?</small>
          </div>
        </div>
      </div>
      <hr />
      <div class="field form-group">
        <%= form.label :decsription %>
        <%= form.rich_text_area :decsription, value: " " %>
      </div>

      <div class="field form-group ">
        <%= form.label :requirements %>
        <%= form.rich_text_area :requirements, value: " " %>
      </div>
    </div>

    <div class="actions">
      <%= form.submit "Add Loan Category", class: "btn btn-lg btn-primary" %>
    </div>
  </div>
<% end %>
