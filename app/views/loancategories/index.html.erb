<!--p id="notice"><%= notice %></p-->
<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="d-flex full-width align-items-center justify-content-between">
      <span class="fs-3 my-3 py-3">Loancategories</span>
      <% if Member.is_manager(current_user.id, @group.id) %>

        <%= link_to "New Loancategory", new_loancategory_path %>
      <% end %>
    </div>
    <div class="bg-white shadow border rounded">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Group</th>
            <th>Created by</th>
            <th>Name</th>
            <th>Period</th>
            <th>Decsription</th>
            <th>Amount</th>
            <th>Interest</th>
            <th>Interest rule</th>
            <th>Required guarantos</th>
            <th>Requirements</th>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @loancategories.each do |loancategory| %>
            <tr>
              <td><%= Group.find(loancategory.group_id).name.humanize %></td>
              <td><%= Account.full_names(loancategory.created_by) %></td>
              <td><%= loancategory.name %></td>
              <td><%= loancategory.period %></td>
              <td><%= loancategory.decsription %></td>
              <td><%= loancategory.amount %></td>
              <td><%= loancategory.interest %></td>
              <td><%= loancategory.interest_rule %></td>
              <td><%= loancategory.required_guarantos %></td>
              <td><%= loancategory.requirements %></td>
              <td><%= link_to "Show", loancategory %></td>
              <td><%= link_to "Edit", edit_loancategory_path(loancategory) %></td>
              <td><%= link_to "Destroy", loancategory, method: :delete, data: { confirm: "Are you sure?" } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>


