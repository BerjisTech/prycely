<% loan_category = @loancategory %>
<div class="row mt-5">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="d-flex whole-width align-items-center justify-content-between">
      <span class="fs-3 my-3 py-3"></span>
      <% if Member.is_manager(current_user.id, @loancategory.group_id) %>
        <div>
          <%= link_to "Edit", edit_loancategory_path(@loancategory), class: "btn btn-primary px-2 make_loan_payment_btn" %>
          <%= link_to "Create New", new_loancategory_path, class: "btn btn-primary px-2" %>
        </div>
      <% end %>
    </div>
    <div class="row bg-white shadow border rounded">
      <div class="col-sm-3 border-end">
        <div class="d-flex flex-column align-items-start justify-content-start">
          <span class="fs-3 my-2">
            <%= link_to loan_category.name, @loancategory %>
          </span>

          <p>
            <strong>Period:</strong>
            <%= @loancategory.period %>
          </p>

          <p>
            <strong>Decsription:</strong>
            <%= @loancategory.decsription %>
          </p>

          <p>
            <strong>Amount:</strong>
            <% if @loancategory.amount.include? 'x' %>
              <%= @loancategory.amount.gsub('x','') %> times member balance
            <% else %>
              <%=  number_with_precision(@loancategory.amount, precision: 2, delimiter: ",") %>
            <% end %>
          </p>

          <p>
            <strong>Interest:</strong>
            <%= @loancategory.interest %>
          </p>

          <p>
            <strong>Interest rule:</strong>
            <%= @loancategory.interest_rule %>
          </p>

          <p>
            <strong>Required guarantos:</strong>
            <%= @loancategory.required_guarantos %>
          </p>

          <p>
            <strong>Required Approvals</strong>
            <%= @loancategory.approvals %>
          </p>

          <p>
            <strong>Requirements:</strong>
            <%= @loancategory.requirements %>
          </p>
        </div>
      </div>
      <div class="col-sm-9 border-start">
        <div class="row" style="background: #F1F1F1;">
          <div class="col-sm-3 border-end">
            <div class="d-flex align-items-center justify-content-center whole-width">
              <span class="my-3">
                <span class="fs-4"><%= Loan.where(loan_type: @loancategory.id, group_id: @loancategory.group_id).count %></span><br />
                <small>No of times requested</small>
              </span>
            </div>
          </div>
          <div class="col-sm-3 border-end">
            <div class="d-flex align-items-center justify-content-center whole-width">
              <span class="my-3">
                <span class="fs-4"><%= number_with_precision(Loan.where(loan_type: @loancategory.id, group_id: @loancategory.group_id).pluck('SUM(amount)').first || 0, precision: 2, delimiter: ",") %></span><br />
                <small>Amount taken</small>
              </span>
            </div>
          </div>
          <div class="col-sm-3 border-end">
            <div class="d-flex align-items-center justify-content-center whole-width">
              <span class="my-3">
                <span class="fs-4"><%= number_with_precision(Loan.where(loan_type: @loancategory.id, group_id: @loancategory.group_id).pluck('SUM(amount_paid)').first || 0, precision: 2, delimiter: ",") %></span><br />
                <small>Amount paid</small>
              </span>
            </div>
          </div>
          <div class="col-sm-3">
            <div class="d-flex align-items-center justify-content-center whole-width">
              <span class="my-3">
                <span class="fs-4"><%= number_with_precision(Loan.where(loan_type: @loancategory.id, group_id: @loancategory.group_id).pluck('SUM(amount_due)').first || 0, precision: 2, delimiter: ",") %></span><br />
                <small>Amount due</small>
              </span>
            </div>
          </div>
        </div>
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Amount</td>
              <th>Given to</td>
              <th>Date</td>
            </tr>
          </thead>
          <tbody>
            <% @loan_category_data.map do |loan| %>
              <tr>
                <th><%= number_with_precision(loan.amount, precision: 2, delimiter: ",")%></td>
                <th><%= Account.full_names(loan.user_id)%></td>
                <th><%= loan.created_at.strftime("#{loan.created_at.day.ordinalize} %b, %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>
