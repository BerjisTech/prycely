<%= form_with(model: error) do |form| %>
  <% if error.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(error.errors.count, "error") %> prohibited this error from being saved:</h2>

      <ul>
        <% error.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field form-group col-sm-12">
    <%= form.label :error %>
    <%= form.text_area :error %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :time %>
    <%= form.datetime_select :time %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
