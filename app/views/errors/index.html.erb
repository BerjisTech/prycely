<!--p id="notice"><%= notice %></p-->

<h1>Errors</h1>

<table class="table table-hover">
  <thead class="table-dark bg-dark">
    <tr>
      <th>Error</th>
      <th>Time</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @errors.each do |error| %>
      <tr>
        <td><%= error.error %></td>
        <td><%= error.time %></td>
        <td><%= link_to "Show", error %></td>
        <td><%= link_to "Edit", edit_error_path(error) %></td>
        <td><%= link_to "Destroy", error, method: :delete, data: { confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New Error", new_error_path %>
