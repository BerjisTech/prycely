<%= form_with(model: currency) do |form| %>
  <% if currency.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(currency.errors.count, "error") %> prohibited this currency from being saved:</h2>

      <ul>
        <% currency.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field form-group col-sm-12">
    <%= form.label :currency %>
    <%= form.text_field :currency %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :code %>
    <%= form.text_field :code %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :country %>
    <%= form.text_field :country %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :country_code %>
    <%= form.text_field :country_code %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
