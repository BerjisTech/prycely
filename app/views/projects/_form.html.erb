
<%= form_with(model: project) do |form| %>
  <% if project.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h2>

      <ul>
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <div class="field col-sm-6">
      <div class="form-floating">
        <%= form.text_field :title, class: "form-control", placeholder: "Placholder" %>
        <%= form.label :title %>
      </div>
    </div>
    <div class="field col-sm-6">
      <div class="form-floating">
        <%= form.number_field :amount, class: "form-control", placeholder: "Placholder" %>
        <%= form.label :budget %>
      </div>
    </div>

    <div class="field form-group col-sm-12 mt-3">
      <%= form.label :description, class: "fs-4 mb-2" %>
      <%= form.rich_text_area :description %>
    </div>

    <%= form.hidden_field :created_by, value: current_user.id %>
    <%= form.hidden_field :group_id, value: @group.id %>

    <div class="actions">
      <%= form.submit class: "btn btn-primary btn-lg mt-4 mb-3"%>
    </div>
  </div>
<% end %>
