<%= form_with(model: account) do |form| %>
  <% if account.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(account.errors.count, "error") %> prohibited this account from being saved:</h2>

      <ul>
        <% account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :user_id, value: current_user.id %>

  <div class="spacer clearfix mt-5"></div>
  <div class="row">
    <div class="col-sm-4">
      <div class="d-flex flex-column align-items-start jsutify-content-center mb-3"></div>
    </div>
    <div class="col-sm-8">
      <div class="border rounded bg-white p-4 shadow">
        <div class="field">
          <div class="d-flex flex-column align-items-center justify-content-center fileinput fileinput-new" data-provides="fileinput">
            <%= form.label(:image, class: "image_select_label d-flex flex-column align-items-center justify-content-center") do %>
              <% if @account.image.attached? %>
                <%= image_tag @account.image.variant(resize: "500x500"), id: "img_prev", class: "img rounded", src: "", alt: "", width: 200 %>
                <span class="select_image btn btn-warning my-2" style="width: 200px;">Change Photo</span>
                <%= form.file_field :image, class: "account_image_to_hide", accept: "image/*", direct_upload: true %>
              <% else %>
                <img id="img_prev" class="img rounded" src="https://assets.prycely.com/images/Default-avatar.jpg" alt="" width="200" />
                <span class="select_image btn btn-primary my-2" style="width: 200px;">Choose Photo</span>
                <%= form.file_field :image, class: "account_image_to_hide", accept: "image/*", direct_upload: true %>
              <% end %>
            <% end %>

            <div class="alert alert-info alert-dismissable">
              Update your account with your info to make it easier for your group and group members to keep records and contact you when needed
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-12 my-5 border-bottom"></div>
  </div>

  <div class="row">
    <div class="col-sm-4">
      <div class="d-flex flex-column align-items-start jsutify-content-center mb-3">
        <span class="fs-2">Personal Details</span>
        <span class="fs-6"></span>
      </div>
    </div>
    <div class="col-sm-8">
      <div class="border rounded bg-white p-4 shadow">
        <div class="field form-floating my-2">
          <%= form.text_field :first_name, class: "form-control", required: "required", placeholder: "Placeholder" %>
          <%= form.label :first_name %>
        </div>

        <div class="field form-floating my-2">
          <%= form.text_field :last_name, class: "form-control", required: "required", placeholder: "Placeholder" %>
          <%= form.label :last_name %>
        </div>

        <div class="field form-floating my-2">
          <%= form.text_field :phone, class: "form-control", required: "required", placeholder: "+254 7********", placeholder: "Placeholder" %>
          <%= form.label "Phone (Include country code)" %>
        </div>
      </div>
    </div>
    <div class="col-sm-12 my-5 border-bottom"></div>
  </div>
  <div class="row">
    <div class="col-sm-4">
      <div class="d-flex flex-column align-items-start jsutify-content-center mb-3">
        <span class="fs-2">Locale</span>
        <span class="fs-6"></span>
      </div>
    </div>
    <div class="col-sm-8">
      <div class="border rounded bg-white p-4 shadow">

        <div class="field form-group my-2">
          <%= form.label :country %>
          <%= form.country_select("country", { include_blank: "Select a country" }, { class: "form-control select2", required: "required", placeholder: "Placeholder" }) %>
        </div>

        <div class="field form-floating my-2">
          <%= form.text_field :county, class: "form-control", required: "required", placeholder: "Placeholder" %>
          <%= form.label "County/Province/State" %>
        </div>

        <div class="field form-floating">
          <%= form.text_field :city, class: "form-control", required: "required", placeholder: "Placeholder" %>
          <%= form.label :city %>
        </div>

        <div class="field form-group my-2">
          <%= form.label :default_currency %>
          <%= form.currency_select("default_currency", {}, {include_blank: "Select a currency"}, { class: "form-control select2", required: "required", placeholder: "Placeholder" }) %>
        </div>

      </div>
    </div>
    <div class="col-sm-12 my-5 border-bottom"></div>
  </div>
  <div class="row">
    <div class="col-sm-4">
      <div class="d-flex flex-column align-items-start jsutify-content-center mb-3">
        <span class="fs-2">Address</span>
        <span class="fs-6"></span>
      </div>
    </div>
    <div class="col-sm-8">
      <div class="border rounded bg-white p-4 shadow">
        <div class="field form-floating my-2oup">
          <%= form.text_field :street, class: "form-control", required: "required", placeholder: "Placeholder" %>
          <%= form.label :street %>
        </div>

        <div class="field form-floating my-2up">
          <%= form.text_field :address, class: "form-control", required: "required", placeholder: "Placeholder" %>
          <%= form.label :address %>
        </div>

        <div class="field form-floating my-2oup">
          <%= form.text_field :postal, class: "form-control", required: "required", placeholder: "Placeholder" %>
          <%= form.label :postal %>
        </div>
      </div>
    </div>
    <div class="col-sm-12 my-5 border-bottom"></div>
  </div>

  <div class="row">
    <div class="col-sm-4">
      <div class="d-flex flex-column align-items-start jsutify-content-center mb-3"></div>
    </div>
    <div class="col-sm-8">
      <div class="actions">
        <%= form.submit "Update Account", class: "btn btn-primary pull-right", data: { disable_with: "Updating..." } %>
      </div>
    </div>
    <div class="col-sm-12 my-5 border-bottom"></div>
  </div>

<% end %>

<style>
  .account_image_to_hide{
    position: absolute;
      margin-top: -9000000px;
      margin-left: -9000000px;
      opacity: 0;
      filter: alpha(opacity=0);
      transform: translate(-300px, 0) scale(4);
      font-size: 23px;
      direction: ltr;
      cursor: pointer;
  }
</style>
