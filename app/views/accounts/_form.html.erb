<%= form_with(model: account) do |form| %>
  <% if account.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(account.errors.count, "error") %> prohibited this account from being saved:</h2>

      <ul>
        <% account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <%= form.number_field :user_id, value: current_user.id, type: :hidden %>

    <div class="field">

      <%= form.label(:image, class: "d-flex flex-column justify-content-center align-items-center") do %>
        <% if @account.image.attached? %>
          <%= image_tag @account.image.variant(resize: "200x200"), id: "img_prev", class: "img rounded", src: "", alt: "" %>
        <% else %>
          <img id="img_prev" class="img rounded" src="" alt="" />
        <% end %>
        <span class="btn btn-xs btn-outline-primary my-1 image_chooser">Choose Photo</span>
        <%= form.file_field :image, onchange: "readURL(this);", class: "d-none", accept: "image/*", required: "required" %>
      <% end %>
    </div>

    <div class="field form-group form-floating my-2 px-2 col-sm-6">
      <%= form.text_field :first_name, class: "form-control", placeholder: "Placeholder", required: "required" %>
      <%= form.label :first_name %>
    </div>

    <div class="field form-group form-floating my-2 px-2 col-sm-6">
      <%= form.text_field :last_name, class: "form-control", placeholder: "Placeholder", required: "required" %>
      <%= form.label :last_name %>
    </div>

    <div class="field form-group form-floating my-2 px-2 col-sm-12">
      <%= form.text_field :phone, class: "form-control", placeholder: "Placeholder", required: "required" %>
      <%= form.label :phone %>
    </div>

    <h3>Add your address below</h3>
    <hr/>

    <div class="field form-group form-floating my-2 px-2 col-sm-4">
      <%= form.country_select("country", { include_blank: "Select a country" }, { class: "form-control form-select", required: "required" }) %>
      <%= form.label :country %>
    </div>

    <div class="field form-group form-floating my-2 px-2 col-sm-4">
      <%= form.text_field :county, class: "form-control", placeholder: "Placeholder", required: "required" %>
      <%= form.label :county %>
    </div>

    <div class="field form-group form-floating my-2 px-2 col-sm-4">
      <%= form.text_field :city, class: "form-control", placeholder: "Placeholder", required: "required" %>
      <%= form.label :city %>
    </div>

    <div class="field form-group form-floating my-2 px-2 col-sm-4">
      <%= form.text_field :street, class: "form-control", placeholder: "Placeholder", required: "required" %>
      <%= form.label :street %>
    </div>

    <div class="field form-group form-floating my-2 px-2 col-sm-4">
      <%= form.text_field :address, class: "form-control", placeholder: "Placeholder", required: "required" %>
      <%= form.label :address %>
    </div>

    <div class="field form-group form-floating my-2 px-2 col-sm-4">
      <%= form.text_field :postal, class: "form-control", placeholder: "Placeholder", required: "required" %>
      <%= form.label :postal %>
    </div>

    <div class="actions">
      <%= form.submit class: "btn btn-outline-primary btn-md my-3" %>
    </div>
  </div >
<% end %>

<!-- Assume jQuery is loaded -->
<script>
  function readURL(input) {
    if (input.files && input.files[0]) {
      var reader = new FileReader();
  
      reader.onload = function (e) {
        $('#img_prev')
          .attr('src', e.target.result)
          .width(200)
          .height(auto)
        $('.image_chooser').html('Change Profile Image')
      };
  
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
