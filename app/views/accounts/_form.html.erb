<%= form_with(model: account) do |form| %>
  <% if account.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(account.errors.count, "error") %> prohibited this account from being saved:</h2>

      <ul>
        <% account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row form_accounts">
    <%= form.number_field :user_id, value: current_user.id, type: :hidden %>

    <div class="field col-sm-3">
      <div class="account_inputs_section fileinput fileinput-new" data-provides="fileinput">
        <%= form.label(:image, class: "image_select_label") do %>
          <% if @account.image.attached? %>
            <%= image_tag @account.image.variant(resize: "200x200"), id: "img_prev", class: "img rounded", src: "", alt: "" %>
          <% else %>
            <img id="img_prev" class="img rounded" src="https://placehold.it/200x150" alt="" />
          <% end %>
          <span class="select_image">Choose Photo</span>
          <%= form.file_field :image, onchange: "readURL(this);", class: "account_image_to_hide", accept: "image/*", required: "required", direct_upload: true %>
        <% end %>

        <div class="alert alert-info alert-dismissable">
          Update your account with your info to make it easier for your group and group members to keep records and contact you when needed
        </div>
      </div>
    </div>

    <div class="col-sm-9">
      <div class="account_inputs_section">
        <div class="personal">
          <h3 class="text-info">Personal Info</h3>
          <hr />
          <div class="field form-group col-md-4 col-sm-6">
            <%= form.label :first_name %>
            <%= form.text_field :first_name, class: "form-control", required: "required" %>
          </div>

          <div class="field form-group col-md-4 col-sm-6">
            <%= form.label :last_name %>
            <%= form.text_field :last_name, class: "form-control", required: "required" %>
          </div>

          <div class="field form-group col-md-4 col-sm-6">
            <%= form.label :phone %>
            <%= form.text_field :phone, class: "form-control", required: "required" %>
          </div>
        </div>
        <div class="address">

          <h3 class="text-info">Address</h3>
          <hr/>
          <div class="field col-sm-6">
            <%= form.label :country %>
            <%= form.country_select("country", { include_blank: "Select a country" }, { class: "form-control select2", required: "required" }) %>
          </div>

          <div class="field form-group col-sm-6">
            <%= form.label :county %>
            <%= form.text_field :county, class: "form-control", required: "required" %>
          </div>

          <div class="field form-group col-sm-6">
            <%= form.label :city %>
            <%= form.text_field :city, class: "form-control", required: "required" %>
          </div>

          <div class="field form-group col-sm-6">
            <%= form.label :street %>
            <%= form.text_field :street, class: "form-control", required: "required" %>
          </div>

          <div class="field form-group col-sm-6">
            <%= form.label :address %>
            <%= form.text_field :address, class: "form-control", required: "required" %>
          </div>

          <div class="field form-group col-sm-6">
            <%= form.label :postal %>
            <%= form.text_field :postal, class: "form-control", required: "required" %>
          </div>
        </div>
      </div>
    </div>

    <div class="actions col-xs-12">
      <%= form.submit "Update Account", class: "submit_btn pull-right" %>
    </div>
  </div >
<% end %>
<script>
  function readURL(input) {
    if (input.files && input.files[0]) {
      var reader = new FileReader();
  
      reader.onload = function (e) {
        $('#img_prev')
          .attr('src', e.target.result)
          .width(200)
          .height(auto)
        $('.image_chooser').html('Change Profile Image')
      };
  
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>

<style>
  .account_image_to_hide{
    position: absolute;
      margin-top: -9000000px;
      margin-left: -9000000px;
      opacity: 0;
      filter: alpha(opacity=0);
      transform: translate(-300px, 0) scale(4);
      font-size: 23px;
      direction: ltr;
      cursor: pointer;
  }
</style>
