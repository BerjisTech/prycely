<!--p id="notice"><%= notice %></p-->

<h1>Accounts</h1>

<table class="table table-bordered datatable" id="datatable">
  <thead class="table-dark bg-dark">
    <tr>
      <th>User</th>
      <th>Phone</th>
      <th>First name</th>
      <th>Last name</th>
      <th>Photo</th>
      <th>Deactivated</th>
      <th>Verified</th>
      <th>Country</th>
      <th>County</th>
      <th>City</th>
      <th>Street</th>
      <th>Address</th>
      <th>Postal</th>
      <th>Type</th>
      <th>Tour</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @accounts.each do |account| %>
      <tr>
        <td><%= account.user_id %></td>
        <td><%= account.phone %></td>
        <td><%= account.first_name %></td>
        <td><%= account.last_name %></td>
        <td>
          <% if account.image.attached? %>
            <%= image_tag account.image.variant(resize: "500x500") %>
          <% else %>
            <img class="img rounded" src="https://assets.prycely.ams3.digitaloceanspaces.com/images/Default-avatar.jpg" alt="" />
          <% end %>
        </td>
        <td><%= account.deactivated %></td>
        <td><%= account.verified %></td>
        <td><%= account.country %></td>
        <td><%= account.county %></td>
        <td><%= account.city %></td>
        <td><%= account.street %></td>
        <td><%= account.address %></td>
        <td><%= account.postal %></td>
        <td><%= account.account_type %></td>
        <td><%= account.tour %></td>
        <td><%= link_to "Show", account %></td>
        <td><%= link_to "Edit", edit_account_path(account) %></td>
        <!--td><%= link_to "Destroy", account, method: :delete, data: { confirm: "Are you sure?" } %></td-->
      </tr>
    <% end %>
  </tbody>
</table>
