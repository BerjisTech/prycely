<div>
  <div class="col-sm-3">
    <div class="account_page_image_section">
      <% if @account.image.attached? %>
        <%= image_tag @account.image.variant(resize: "500x500") %>
      <% else %>
        <img id="img_prev" class="img rounded" src="https://placehold.it/200x150" alt="" />
      <% end %>
      <img class="country_image" src="https://assets.prycely.com/images/flags/<%= @account.country.downcase %>.svg" />
      <div class="groups_and_wallets">
        <div class="groups">
          <span><%= Group.mine(current_user.id).count %></span>
          <span>Groups</span>
        </div>
        <div class="wallets">
          <span><%= Wallet.mine(current_user.id).count %></span>
          <span>Wallets</span>
        </div>
      </div>

      <div class="contacts">
        <h3>Contacts</h3>
        <div>
          <span class="material-icons">emoji_people</span>
          <span><%= "#{@account.first_name.humanize} #{@account.last_name.humanize}" %></span>
        </div>
        <div>
          <span class="material-icons">call</span>
          <span><%= @account.phone %></span>
        </div>
        <div>
          <span class="material-icons">email</span>
          <span><%= User.find(@account.user_id).email %></span>
        </div>
      </div>

      <div class="actions">
        <% if @account.user_id == current_user.id %>
          <%= link_to "Edit", edit_account_path(@account) %> |
          <%= link_to "Back", accounts_path %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-sm-9">
    <div class="account_page_detail_section">
      <h3>A force to be reckoned with! Something great is coming here.</h3>
    </div>
  </div>
</div>
