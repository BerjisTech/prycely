<h2>Log in</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="col-sm-6">
    <div class="field form-group form-floating col my-3">
      <%= f.email_field :email, class: "form-control", autofocus: true, autocomplete: "email", placeholder: "Email" %>
      <%= f.label :email %>
    </div>

    <div class="field form-group form-floating col my-3">
      <%= f.password_field :password, class: "form-control", autocomplete: "current-password", placeholder: "Password" %>
      <%= f.label :password %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <div class="actions">
      <%= f.submit "Log in", class: "btn btn-outline-primary btn-md my-3" %>
    </div>
  </div>
<% end %>

<%= render "devise/shared/links" %>
