<p id="notice"><%= notice %></p>

<h1>Paybills</h1>

<table class="table table-responsive table-hover">
  <thead class="table-dark bg-dark">
    <tr>
      <th>Request</th>
      <th>Type</th>
      <th>Transaction reference</th>
      <th>Paybill balance</th>
      <th>Third party transaction</th>
      <th>Invoice number</th>
      <th>Amount</th>
      <th>First name</th>
      <th>Last name</th>
      <th>Middle name</th>
      <th>Phone</th>
      <th>Short code</th>
      <th>Account number</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @paybills.each do |paybill| %>
      <tr>
        <td><%= paybill.request %></td>
        <td><%= paybill.type %></td>
        <td><%= paybill.transaction_reference %></td>
        <td><%= paybill.paybill_balance %></td>
        <td><%= paybill.third_party_transaction_id %></td>
        <td><%= paybill.invoice_number %></td>
        <td><%= paybill.amount %></td>
        <td><%= paybill.first_name %></td>
        <td><%= paybill.last_name %></td>
        <td><%= paybill.middle_name %></td>
        <td><%= paybill.phone %></td>
        <td><%= paybill.short_code %></td>
        <td><%= paybill.account_number %></td>
        <td><%= link_to "Show", paybill %></td>
        <td><%= link_to "Edit", edit_paybill_path(paybill) %></td>
        <td><%= link_to "Destroy", paybill, method: :delete, data: { confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New Paybill", new_paybill_path %>
