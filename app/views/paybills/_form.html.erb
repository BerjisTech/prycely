<%= form_with(model: paybill) do |form| %>
  <% if paybill.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(paybill.errors.count, "error") %> prohibited this paybill from being saved:</h2>

      <ul>
        <% paybill.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
