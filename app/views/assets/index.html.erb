<p id="notice"><%= notice %></p>

<h1>Assets</h1>

<table class="table table-responsive table-hover">
  <thead class="table-dark bg-dark">
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Group</th>
      <th>Date bought</th>
      <th>Date sold</th>
      <th>Added by</th>
      <th>Price</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @assets.each do |asset| %>
      <tr>
        <td><%= asset.name %></td>
        <td><%= asset.description %></td>
        <td><%= asset.group_id %></td>
        <td><%= asset.date_bought %></td>
        <td><%= asset.date_sold %></td>
        <td><%= asset.added_by %></td>
        <td><%= asset.price %></td>
        <td><%= link_to "Show", asset %></td>
        <td><%= link_to "Edit", edit_asset_path(asset) %></td>
        <td><%= link_to "Destroy", asset, method: :delete, data: { confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New Asset", new_asset_path %>
