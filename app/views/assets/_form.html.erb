<div class="row">
  <%= form_with(model: asset) do |form| %>
    <% if loan.errors.any? %>
      <div id="error_explanation d-flex flex-column align-items-start justify-content-start">
        <div class="alert alert-warning"><%= pluralize(loan.errors.count, "error") %> prohibited this loan from being saved:</div>
        <% loan.errors.each do |error| %>
          <div class="alert alert-danger"><%= error.full_message %></div>
        <% end %>
      </div>
    <% end %>

    <%= form.number_field :group_id, value: @group.id %>

    <div class="row">
      <div class="col-sm-6">
        <div class="field form-group">
          <%= form.label :name %>
          <%= form.text_field :name %>
        </div>
    <div class="field form-group">
      <%= form.label :date_bought %>
      <%= form.datetime_select :date_bought %>
    </div>
      </div>
      <div class="col-sm-6">
        <div class="field form-group">
          <%= form.label :description %>
          <%= form.text_area :description %>
        </div>
      </div>
    </div>

      

    <div class="field form-group">
      <%= form.label :date_bought %>
      <%= form.datetime_select :date_bought %>
    </div>

    <div class="field form-group">
      <%= form.label :date_sold %>
      <%= form.datetime_select :date_sold %>
    </div>

    <div class="field form-group">
      <%= form.label :added_by %>
      <%= form.number_field :added_by %>
    </div>

    <div class="field form-group">
      <%= form.label :price %>
      <%= form.text_field :price %>
    </div>

    <div class="actions">
      <%= form.submit %>
    </div>
  <% end %>
</div>
