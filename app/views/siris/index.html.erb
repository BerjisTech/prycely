<p id="notice"><%= notice %></p>

<h1>Siris</h1>

<table class="table table-responsive">
  <thead>
    <tr>
      <th>Name</th>
      <th>Value</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @siris.each do |siri| %>
      <tr>
        <td><%= siri.name %></td>
        <td><%= siri.value.truncate(50) %></td>
        <td>
          <%= link_to "Show", siri %> | 
          <%= link_to "Edit", edit_siri_path(siri) %> |
          <%= link_to "Destroy", siri, method: :delete, data: { confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New Siri", new_siri_path %>
