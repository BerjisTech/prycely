<%= form_with(model: group) do |form| %>
  <% if group.errors.any? %>
    <div id="error_explanation d-flex flex-column align-items-start justify-content-start">
      <div class="alert alert-warning"><%= pluralize(group.errors.count, "error") %> prohibited this group from being saved:</div>
      <% group.errors.each do |error| %>
        <div class="alert alert-danger"><%= error.full_message %></div>
      <% end %>
    </div>
  <% end %>
  <%= form.text_field :created_by, value: current_user.id, type: :hidden %>
  <div class="field form-floating my-4">
    <%= form.text_field :name, class: "form-control form-control-sm", placeholder: "Placeholder", required: "required" %>
    <%= form.label :name %>
  </div>
  <div class="field form-group my-4">
    <%= form.label :currency %>
    <%= form.currency_select(:currency, {}, { include_blank: "Select Group Currency" }, { class: "form-control select2", required: "required" }) %>
  </div>
  <div class="field form-group my-4">
    <%= form.label :group_type %>
    <%= select_tag("group[group_type]", options_from_collection_for_select(Grouptype.all, :id, :name), { :class => "form-control select2", prompt: "Group Type", required: "required" }) %>
  </div>
  <div class="field form-floating my-4">
    <%= form.number_field :membership, class: "form-control", placeholder: "Placeholder", required: "required", value: 0, step: "0.01" %>
    <%= form.label :membership %>
  </div>
  <div class="actions">
    <%= form.submit class: "btn btn-primary btn-md my-3" %>
  </div>
<% end %>
