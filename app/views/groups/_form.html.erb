<div class="row">
  <%= form_with(model: group) do |form| %>
    <% if group.errors.any? %>
      <div id="error_explanation d-flex flex-column align-items-start justify-content-start">
        <div class="alert alert-warning"><%= pluralize(group.errors.count, "error") %> prohibited this group from being saved:</div>
        <% group.errors.each do |error| %>
          <div class="alert alert-danger"><%= error.full_message %></div>
        <% end %>
      </div>
    <% end %>
    <div class="col-sm-6">

      <%= form.text_field :created_by, value: current_user.id, type: :hidden %>

      <div class="field form-group form-floating my-4">
        <%= form.text_field :name, class: "form-control form-control-sm", required: "required" %>
        <%= form.label :name %>
      </div>

      <div class="field form-group form-floating my-4">
        <%= form.currency_select(:currency, {}, { include_blank: "Select Group Currency" }, { class: "form-control", required: "required" }) %>
        <%= form.label :currency %>
      </div>

      <div class="field form-group form-floating my-4">
        <%= select_tag("group[group_type]", options_from_collection_for_select(Grouptype.all, :id, :name), { :class => "form-control select2 m-2", prompt: "Group Type", required: "required" }) %>
        <%= form.label :group_type %>
      </div>

      <div class="field form-group form-floating my-4">
        <%= form.number_field :membership, class: "form-control", required: "required", value: 0, step: "0.01" %>
        <%= form.label :membership %>
      </div>

      <div class="actions">
        <%= form.submit class: "btn btn-primary btn-md my-3" %>
      </div>
    </div>
  <% end %>
</div>
