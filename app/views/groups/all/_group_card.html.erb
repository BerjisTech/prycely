<table class="table table-hover shadow border">
  <thead>
    <tr>
      <td>Group</td>
      <td>Created by</td>
      <td>Balance</td>
      <td>Joined on</td>
      <td></td>
    </tr>
  </thead>
  <tbody>
    <% @groups.each_with_index.map do |group, index| %>
      <tr>
        <td>
          <%= group.name.humanize %>
        </td>
        <td><em><%= link_to Account.find_by(user_id: group.created_by).first_name.humanize, account_path(Account.find_by(user_id: group.created_by).id), class: "nav-link", style: "margin: 0px; padding: 0px;" %></em></td>
        <td>
          <%= Money::Currency.find(group.currency).symbol %><span class="fs-5"> <%= number_with_precision(Group.balance(group.group_id), precision: 2, delimiter: ',')%></span>
        </td>
        <td>
          <span style="font-size: 10px;"><%= group.accepted_on.strftime("%A #{group.accepted_on.day.ordinalize}, %B %Y") %></span>
        </td>
        <td>
          <%= link_to "View", group_path(group.group_id), class: "btn btn-sm btn-primary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
