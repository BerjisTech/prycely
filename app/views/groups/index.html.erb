<!--p id="notice"><%= notice %></p-->
<div class="row">
  <div class="d-flex justify-content-end">
    <%= link_to new_group_path, class: "btn btn-outline-primary btn-sm d-flex justify-content-center align-items-center" do %>
      <span>Create New Group</span>
      <span class="material-icons">add</span>
    <% end %>
  </div>
</div>

<div class="row">
  <h1>Groups</h1>

  <div class="groups_holder">
    <% @groups.each do |group| %>
      <%= link_to group_path(group.group_id), class: "group" do %>
        <span class="group_dp"><%= group.name[0] %></span>
        <span class="group_name"><%= group.name %></span>
        <span><%= group.currency %></span>
      <% end %>
    <% end %>
  </div>

</div>
