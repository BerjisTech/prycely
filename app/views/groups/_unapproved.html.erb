<div class="d-flex flex-row align-items-start justify-content-start py-3 flex-wrap">
  <div class="d-flex flex-column justify-content-center align-items-center" style="width: auto; min-width: 300px;">
    <span class="btn btn-outline-primary btn-md mt-2 flex-fill join_group">Join <%= @group.name %></span>
  </div>
  <div class="d-flex flex-column px-2 flex-grow-4 flex-fill">
    <h3 class="h3">Welcome to <%= @group.name %></h3>
    <hr />

    <div class="d-flex p-2">
      <% if @group.description.nil? || @group.description == "" || @group.description == " " %>
        <div class="card py-3 px-2">This group has no description</div>
      <% else %>
        <%= @group.description %>
      <% end %>
    </div>
    <hr />

    <div class="d-flex p-2">
      <% if @group.requirements.nil? || @group.requirements == "" || @group.requirements == " " %>
        <div class="card py-3 px-2">This group has no requirements</div>
      <% else %>
        <%= @group.requirements %>
      <% end %>
    </div>
    <hr />

    <span>You were invited by: <%= @inviter.first_name.humanize %> <%= @inviter.last_name.humanize %></span>
    <span class="btn btn-primary btn-md mt-2 join_group">Join <%= @group.name %> now</span>
  </div>
</div>

<script>
  $('.join_group').on('click', ()=>{
      $.ajax({
          url: '<%= root_url + "accept" %>',
          method: 'GET',
          success: (result) => {console.log(result)},
          error: (error) => {console.log(error)}
      })
  })
</script>
