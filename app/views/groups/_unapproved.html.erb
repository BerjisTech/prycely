<% invite = Invite.find_by(invite_key: session[:invite_key]) %>
<% inviter = Account.find_by(user_id: invite.user_id).user_id %>
<div class="row">
  <div class="col-sm-2"></div>
  <div class="col-sm-8 my-4">
    <h3 class="h3">Welcome to <%= @group.name %></h3>
    <div class="shadow rounded border bg-white my-4 py-3">
      <div class="row">
        <div class="col-sm-2">
          <div class="d-flex flex-column justify-content-center align-items-center">
            <%= link_to root_url + "accept", class: "btn btn-primary btn-md mt-2 join_group" do %>
              Join <%= @group.name %>
            <% end %>
          </div>
        </div>
        <div class="col-sm-10">
          <div class="d-flex flex-column px-2 flex-grow-4 flex-fill">
            <div class="d-flex p-2">
              <% if @group.description.nil? || @group.description == "" || @group.description == " " %>
                <div class="pb-3 px-2">This group has no description</div>
              <% else %>
                <%= @group.description %>
              <% end %>
            </div>
            <hr />

            <div class="d-flex p-2">
              <% if @group.requirements.nil? || @group.requirements == "" || @group.requirements == " " %>
                <div class="py-3 px-2">This group has no requirements</div>
              <% else %>
                <%= @group.requirements %>
              <% end %>
            </div>
            <hr />

            <span>You were invited by: <%= Account.full_names(inviter) %></span>
            <%= link_to root_url + "accept", class: "btn btn-primary btn-md mt-2 join_group" do %>
              Join <%= @group.name %> now
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-2"></div>
  </div>
