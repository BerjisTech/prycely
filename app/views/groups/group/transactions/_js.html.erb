<script>
  jQuery(document).ready(($) => {
    var line_chart_demo = $("#bar-chart-demo");
  
    let draw_graph = (transactions) => {
      $(line_chart_demo).empty()
      var line_chart = Morris.Bar({
          element: 'bar-chart-demo',
          data: transactions,
          xkey: 'y',
          ykeys: ['a','b'],
          labels: ['Debit','Credit'],
          barColors: ['#149DA8'],
          redraw: true,
          stacked: true
      });
      line_chart_demo.parent().attr('style', '');
    }
  
    let fetch_graph_data = (group_id, from, to) => {
        $(line_chart_demo).html('<img src="https://assets.prycely.com/images/preloader.gif" style="width: 100%; height: auto;">')
        $.ajax({
            url: '<%= fetch_group_graph_data_path %>',
            method: 'POST',
            data: {
                'authenticity_token': $('[name="csrf-token"]')[0].content,
                'group_id': group_id,
                'from': from,
                'to': to
            },
            success: (response) => {
                console.log(response)
                if (response.type == 'error' || response.type == 'info') {
                  $(line_chart_demo).html(`<div style="width: 100%; height: 100%;" class="m-3 p-3 d-flex align-items-center justify-content-center">${response.message}</div>`)
                }
                else{
                  draw_graph(response.data)
                }
            },
            error: (response) => {
                $(line_chart_demo).html('<div style="width: 100%; height: 100%;" class="m-3 p-3 d-flex align-items-center justify-content-center">There has been an error fetching your transactions</div>')
            }
        })
    }
  
    $('.fetch_transactions').on('change', (e) => {
        fetch_graph_data('<%= @group.id %>', $(e.target).val(), 0)
    })
  
    fetch_graph_data('<%= @group.id %>', 300, 200)
  })
</script>
