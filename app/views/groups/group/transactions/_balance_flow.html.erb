<div class="col-sm-7">
  <h3>Balance Flow</h3>
  <div class="panel panel-primary shadow border" id="charts_env">
    <div class="panel-heading">
      <div class="panel-title">Site Stats</div>
      <div class="panel-options">
        <select class="form-control fetch_transactions">
          <option value="7">Last 7 days</option>
          <option value="30">Last 30 days</option>
          <option value="90">Last 3 months</option>
          <option value="180">Last 6 months</option>
          <option value="365">Last 365 days</option>
        </select>
      </div>
    </div>
    <div class="panel-body">
      <div class="tab-content">
        <div class="tab-pane active">
          <div style="width: 100%; height: 100%;" class="m-3 p-3 align-items-center justify-content-center" id="chart_area"></div>
          <img src="https://assets.prycely.com/images/preloader.gif" style="width: 100%; height: auto;" id="chart_image">
          <canvas id="chart_pane" data-path="<%= fetch_group_graph_data_path(group_id: params[:id]) %>" width="100%" height="230px" style="display: none; max-height: 250px !important;"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>
