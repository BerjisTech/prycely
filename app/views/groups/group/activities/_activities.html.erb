<table class="table table-hover">
  <thead>
    <tr>
      <th>Activity</th>
      <th>Added by</th>
      <th>Host</th>
      <th>Host Contact</th>
      <th>Price</th>
      <th>Fine</th>
      <th>Date</th>
      <% if Member.is_manager(current_user.id, @group.id) %>
        <th colspan="3"></th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% @activities.map do |activity| %>
      <tr>
        <td><%= activity.title.humanize %></td>
        <td><%= link_to Account.full_names(activity.created_by), activity.created_by %></td>
        <td><%= activity.host.humanize%></dt>
        <td><%= activity.host_contact %></td>
        <td><%= Money::Currency.find(@group.currency).symbol %> <%= number_with_precision(activity.price, precision: 2, delimiter: ",") %></td>
        <td><%= Money::Currency.find(@group.currency).symbol %> <%= number_with_precision(activity.fine, precision: 2, delimiter: ",") %></td>
        <td><%= activity.date.strftime("#{activity.date.day.ordinalize} %b, %Y") %></td>
        <% if Member.is_manager(current_user.id, @group.id) %>
          <td><%= link_to "Show", activity %></td>
          <td><%= link_to "Edit", edit_activity_path(activity) %></td>
          <td><%= link_to "Destroy", activity, method: :delete, data: { confirm: "Are you sure?" } %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
