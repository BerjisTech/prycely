<table class="table table-hover">
  <thead>
    <tr>
      <th>Loan</th>
      <th>Amount</th>
      <th>Given to</th>
      <th>Interest (current)</th>
      <th>Amount Due</th>
      <th>Status</th>
      <th>Guarantors</th>
      <td></td>
    </tr>
  </thead>
  <tbody>
    <% @loans.map do |loan| %>
      <% loan_category = Loancategory.find(loan.loan_type) %>
      <tr>
        <td>
          <%= link_to loan_category.name.humanize, loancategory_path(loan.loan_type) %>
        </td>
        <td>
          <%= number_with_precision(loan.amount, precision: 2, delimiter: ",") %>
        </td>
        <td>
          <span class="fw-bold">
            <%= link_to Account.full_names(loan.user_id), account_path(Account.find_by(user_id: loan.user_id).id) %>
          </span>
        </td>
        <td><%= number_with_precision(loan.interest, precision: 2, delimiter: ",") %> (<%= loan_category.interest %>%)</td>
        <td>
          <%= number_with_precision(loan.amount_due, precision: 2, delimiter: ",") %>
        </td>
        <td>
          <%= Loan.status(loan.status) %>
        </td>
        <td class="guarantor_list_block">
          <% Loan.guarantors(loan.guarantors).map do |guarantor| %>
            <span class="guarantor_span">
              <span class="p-1"><%= Account.full_names(guarantor)%></span>
            </span>
          <% end %>
        </td>
        <td>
          <div class="d-flex align-items-center justify-content-center px-3">
            <%= link_to 'View', loan_path(loan.id) %>
            <% if Member.is_manager(current_user.id) %>
              <% if !LoanApproval.i_approved(loan.id, current_user.id, loan.loan_type) %>
                <a class="material-icons px-3 l_<%= loan.id %> l_approval" loan_manager="<%= current_user.id %>" loan_approval_path="<%= i_approve_path %>" loan_id="<%= loan.id %>">check</a>
              <% end %>
              <% if LoanApproval.i_approved(loan.id, current_user.id, loan.loan_type) %>
                <a class="material-icons text-danger px-3 l_<%= loan.id %> l_approval" loan_manager="<%= current_user.id %>" loan_approval_path="<%= i_disapprove_path %>" loan_id="<%= loan.id %>">cancel</a>
              <% end %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<script>
  $(document).ready(() => {
    let manager = ''
    let approval_path = ''
    let loan_id = ''
    let approval_class = ''

    $('.l_approval').on('click', (e) => {
        e.preventDefault()
        e.stopPropagation()

        let l_approval = $(e.target)

        manager = l_approval.attr('loan_manager')
        approval_path = l_approval.attr('loan_approval_path')
        loan_id = l_approval.attr('loan_id')
        approval_class = $(`.l_${loan_id}`)

        $.ajax({
            url: approval_path,
            data: {
                'authenticity_token': $('[name="csrf-token"]')[0].content,
                'user_id': manager,
                'loan_id': loan_id
            },
            method: 'POST',
            success: (response) => {
              console.log(response)
              response = response[0]
              if (!response.type == 'success') return
              approval_class.attr('loan_approval_path', response.approval_path)
              approval_class.html(response.icon)
              approval_class.removeClass(response.remove_color)
              approval_class.addClass(response.add_color)
              inform('info', response.message)
            },
            error: (error) => {
                console.log(error)
            }
        })
    })
  })
</script>
