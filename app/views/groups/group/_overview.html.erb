<div class="col-sm-6">
  <h3>Overview</h3>
  <div class="group-overview">
    <div class="overview-numbers">
      <div class="overview-numbers-data">
        <div class="available-numbers">
          <span>Available balance in <%= @group.currency %></span>
          <span><%= number_with_precision(@balance, precision: 2, delimiter: ",") %></span>
        </div>
        <div class="available-transactions">
          <div class="transactions">
            <span>Transactions</span>
            <span><%= @total_transactions %></span>
          </div>
          <div class="members">
            <span>Members</span>
            <span><%= @total_members %></span>
          </div>
        </div>
        <div class="available-log">
          <span><%= @last_log %></span>
        </div>
      </div>
      <div class="overview-numbers-graphic">
        <img src="https://assets.prycely.com/images/d6f18dcdfc48ef9c283fa8e68a5c7a9e.png"/>
      </div>
    </div>
    <div class="overview-extras">
      <div class="credit">
        <span>Credit</span>
        <span><%= "#{number_with_precision(@credit, precision: 2, delimiter: ",")} #{@group.currency}" %></span>
      </div>
      <div class="debit">
        <span>Debit</span>
        <span><%= "#{number_with_precision(@debit, precision: 2, delimiter: ",")} #{@group.currency}" %></span>
      </div>
    </div>
    <div class="overview-transact">
      <div class="deposit">
        <span>DEPOSIT</span>
      </div>
      <div class="withdraw">
        <span>WITHDRAW</span>
      </div>
    </div>
  </div>
</div>
