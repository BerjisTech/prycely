<div class="col-sm-5 group-overview">
  <h3>Overview</h3>
  <div class="overview-numbers d-flex flex-column p-3 m-2">
    <span>Available balance in <%= @group.currency %></span>
    <span class="fs-1 fw-bolder my-3"><%= number_with_precision(@balance, precision: 2, delimiter: ",") %></span>
    <div class="row">
      <div class="col-sm-6 d-flex flex-column">
        <span>Transactions</span>
        <span class="fs-3"><%= number_with_precision(@total_transactions, precision: 0, delimiter: ",") %></span>
      </div>
      <div class="col-sm-6 d-flex flex-column">
        <span>Members</span>
        <span class="fs-3"><%= number_with_precision(@total_members, precision: 0, delimiter: ",") %></span>
      </div>
    </div>
    <div><span><%= @last_log %></span></div>
  </div>
  <div class="row overview-extras">
    <div class="col-sm-6">
      <div class="debit">
        <span>Debit</span>
        <span class="fs-3 text-success"><%= "#{number_with_precision(@debit, precision: 2, delimiter: ",")} #{@group.currency}" %></span>
      </div>
    </div>
    <div class="col-sm-6">
      <div class="credit">
        <span>Credit</span>
        <span class="fs-3 text-danger">-<%= "#{number_with_precision(@credit, precision: 2, delimiter: ",")} #{@group.currency}" %></span>
      </div>
    </div>
  </div>
  <div class="row overview-transact">
    <div class="col-sm-6">
      <a href='<%= "#{root_url}deposit/#{Digest::SHA1.hexdigest(1.to_s)}/#{@group.id}" %>' class="d-flex  my-2 py-3 deposit">
        <span>DEPOSIT</span>
      </a>
    </div>
    <div class="col-sm-6">
      <a href='<%= "#{root_url}withdraw/#{Digest::SHA1.hexdigest(1.to_s)}/#{@group.id}" %>' class="d-flex  my-2 py-3 withdraw">
        <span>WITHDRAW</span>
      </a>
    </div>
  </div>
</div>
