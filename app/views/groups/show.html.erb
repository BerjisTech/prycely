<div class="row">
  <div class="col-md-2">
    <%= link_to group_path(@group.id) + "/members", class: "feature" do %>
      <span class="material-icons">groups</span>
      <span>Members</span>
    <% end %>
    <%= link_to group_path(@group.id) + "/transactions", class: "feature" do %>
      <span class="material-icons">receipt_long</span>
      <span>Transactions</span>
    <% end %>
    <%= link_to group_path(@group.id) + "/projects", class: "feature" do %>
      <span class="material-icons">dashboard</span>
      <span>Projects</span>
    <% end %>
    <%= link_to group_path(@group.id) + "/activities", class: "feature" do %>
      <span class="material-icons">local_activity</span>
      <span>Activities</span>
    <% end %>
    <%= link_to group_path(@group.id) + "/loans", class: "feature" do %>
      <span class="material-icons">payments</span>
      <span>Loans</span>
    <% end %>
    <%= link_to group_path(@group.id) + "/income", class: "feature" do %>
      <span class="material-icons">price_change</span>
