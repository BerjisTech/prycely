<%= form_with(model: invite) do |form| %>
  <% if invite.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(invite.errors.count, "error") %> prohibited this invite from being saved:</h2>

      <ul>
        <% invite.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :group_id %>
    <%= form.number_field :group_id %>
  </div>

  <div class="field">
    <%= form.label :invite_key %>
    <%= form.text_area :invite_key %>
  </div>

  <div class="field">
    <%= form.label :max_redeem %>
    <%= form.number_field :max_redeem %>
  </div>

  <div class="field">
    <%= form.label :invite_email %>
    <%= form.text_area :invite_email %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
