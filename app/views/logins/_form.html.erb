<%= form_with(model: login) do |form| %>
  <% if login.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(login.errors.count, "error") %> prohibited this login from being saved:</h2>

      <ul>
        <% login.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field form-group col-sm-12">
    <%= form.label :user_id %>
    <%= form.text_field :user_id %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :time %>
    <%= form.datetime_select :time %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :ip %>
    <%= form.text_field :ip %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :success %>
    <%= form.text_field :success %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :password_attempt %>
    <%= form.text_area :password_attempt %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
