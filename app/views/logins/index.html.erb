<!--p id="notice"><%= notice %></p-->

<h1>Logins</h1>

<table class="table table-bordered datatable" id="datatable">
  <thead class="table-dark bg-dark">
    <tr>
      <th>User</th>
      <th>Time</th>
      <th>Ip</th>
      <th>Success</th>
      <th>Password attempt</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @logins.each do |login| %>
      <tr>
        <td><%= login.user_id %></td>
        <td><%= login.time %></td>
        <td><%= login.ip %></td>
        <td><%= login.success %></td>
        <td><%= login.password_attempt %></td>
        <td><%= link_to "Show", login %></td>
        <td><%= link_to "Edit", edit_login_path(login) %></td>
        <td><%= link_to "Destroy", login, method: :delete, data: { confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New Login", new_login_path %>
