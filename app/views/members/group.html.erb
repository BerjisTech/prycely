<div class="row my-4 py-4">
  <div class="col-xs-12">
    <h3>Members</h3>
  </div>
</div>
<div class="row mb-4 pb-4">
  <div class="col-sm-3">
    <div class="fs-5">Admins & Managers</div>
    <div class="">
      Admins and managers have permision to see and perform high level actions. They can also add, promote and demote other managers
    </div>
  </div>
  <div class="col-sm-9 shadow bg-white rounded border">
    <ul class="nav nav-tabs" id="owners" tole="tablist">
      <li class="nav-item" role="presentation">
        <a class="nav-link active" id="active_owners" data-bs-toggle="tab" href="#active_owners_list" role="tab" aria-controls="active_owners_list" aria-selected="true">Active</a>
      </li>
      <li class="nav-item" role="presentation">
        <a class="nav-link" id="invited_owners" data-bs-toggle="tab" href="#invited_owners_list" role="tab" aria-controls="invited_owners_list" aria-selected="false">Invited</a>
      </li>
    </ul>
    <div class="tab-content" id="owner_list">
      <div class="tab-pane fade show active" id="active_owners_list" role="tabpanel" arialabelledby="active_owners">
        <table class="table table-hover">
          <% @managers.each_with_index.map do |member, index| %>
            <% if Member.is_manager(member.user_id, member.group_id) %>
              <tr border="0">
                <td>
                  <span class="d-flex align-items-center justify-content-center" style="height: 40px; width: 40px; font-size: 20px; background: #FDEDEE; color: #E14141; border-radius: 10px;"><%= member.first_name[0...2] %></span>
                </td>
                <td><%= "#{member.first_name} #{member.last_name}" %></td>
                <td><%= Designation.find(member.designation).name.humanize %></td>
              </tr>
            <% end %>
          <% end %>
        </table>
      </div>
      <div class="tab-pane fade" id="invited_owners_list" role="tabpanel" arialabelledby="invited_owners">Invited</div>
    </div>
  </div>
</div>
<hr />
<div class="row m4-4 py-4">
  <div class="col-sm-3">
    <div class="fs-5">Members</div>
    <div class="">
      Admins and managers have permision to see and perform high level actions. They can also add, promote and demote other managers
    </div>
  </div>
  <div class="col-sm-9 shadow bg-white rounded border">
    <ul class="nav nav-tabs" id="members" tole="tablist">
      <li class="nav-item" role="presentation">
        <a class="nav-link active" id="active_members" data-bs-toggle="tab" href="#active_members_list" role="tab" aria-controls="active_members_list" aria-selected="true">Active</a>
      </li>
      <li class="nav-item" role="presentation">
        <a class="nav-link" id="invited_members" data-bs-toggle="tab" href="#invited_members_list" role="tab" aria-controls="invited_members_list" aria-selected="false">Invited</a>
      </li>
    </ul>
    <div class="tab-content" id="owner_list">
      <div class="tab-pane fade show active" id="active_members_list" role="tabpanel" arialabelledby="active_members">
        <table class="table table-hover">
          <% @members.each_with_index.map do |member, index| %>
            <% if !Member.is_manager(member.user_id, member.group_id) %>
              <tr border="0">
                <td>
                  <span class="d-flex align-items-center justify-content-center" style="height: 40px; width: 40px; font-size: 20px; background: #FDEDEE; color: #E14141; border-radius: 10px;"><%= member.first_name[0...2] %></span>
                </td>
                <td><%= "#{member.first_name} #{member.last_name}" %></td>
                <td><%= Designation.find(member.designation).name.humanize %></td>
              </tr>
            <% end %>
          <% end %>
        </table>
      </div>
      <div class="tab-pane fade" id="invited_members_list" role="tabpanel" arialabelledby="invited_members">Invited</div>
    </div>
  </div>
</div>

