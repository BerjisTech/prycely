<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
  <div class="members_holder">
    <div class="member_top">
      <h3><%= @group.name %> Members</h3>
      <%= render "members/invite_buttons" %>
    </div>
    <div class="members_table rounded bg-white border shadow">
      <table class="table table-hover" style="font-size: 16px !important;">
        <thead>
          <tr>
            <th>Status</th>
            <th>NAME AND ROLE</th>
            <th>EMAIL</th>
          </tr>
        </thead>
        <tbody>
          <% @members.each do |member| %>
            <tr>
              <td><%= Member.status(member.status.to_i) %></td>
              <td>
                <%= member.first_name.humanize %> <%= member.last_name.humanize %>
                <% if Member.is_manager(member.user_id, member.group_id) %>
                  <em class="text-success"><small>(<%= Designation.find(member.designation).name %>)</small></em>
                <% end %>
              </td>
              <td><%= member.email %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  </div>
  <div class="col-sm-1"></div>
</div>

<script>
  title = `<%= @group.name %> Members`;
  window.document.title = title
</script>
