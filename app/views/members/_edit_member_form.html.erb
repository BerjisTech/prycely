<%= form_with(model: member) do |form| %>
  <% if member.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(member.errors.count, "error") %> prohibited this member from being saved:</h2>

      <ul>
        <% member.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :invited_by %>
  <%= form.hidden_field :user_id %>

  <div class="bg-white rounded border shadow p-4">
    <div class="field form-floating">
      <%= form.text_field :designation, class: "form-control my-2", placeholder: "Placeholder" %>
      <%= form.label :designation %>
    </div>
    <div class="field form-floating">
      <%= form.select :status, options_for_select({
        'Pending' => '0', 
        'Approved' => '1', 
        'Denied' => '2', 
        'Deregistered' => '3'
      }, member.status), {}, class: "form-control my-2 select2", placeholder: "Placeholder" %>
      <%= form.label :staus do %>
        Member status
      <% end %>
    </div>

    <div class="actions">
      <%= form.submit class: "btn btn-primary my-3" %>
    </div>
  </div>
<% end %>
