<script>
  topup_amount = $('.tu-amount').val()
    const get_conversion = (origin, recepient, topup_amount) => {
        $('.goToPayChoice').html('<img src="https://assets.prycely.ams3.digitaloceanspaces.com/images/loader.gif" style="width: 200px;"/>')
        $.ajax({
            url: '<%= convert_url %>',
            data: {
                'amount': topup_amount,
                'origin': origin,
                'recepient': recepient
            },
            method: 'POST',
            success: (response) => {
                console.log(response)
                $('.bdPay .breakDownValue').html(`${response.converted} ${recepient}`)
                $('.bdFee .breakDownValue').html(`${response.fee} ${recepient}`)
                $('.bdConvert .breakDownValue').html(`${response.actual_amount} ${recepient}`)
                $('.bdRate .breakDownValue').html(response.rate)
                $('.goToPayChoice').html('SEND MONEY')
            },
            error: (response) => {
                console.log(response)
            }
        })
    }
  
      $('.tu-wallet-details').attr('data-currency', '<%= @active_currency %>')
      $('.tu-title').html(`Topup <%= @account_name %>`)
      $('.tu-wallet-details img').attr('src', '<%= @assets_path %><%= @active_flag %>.svg')
      $('.tu-wallet-details span:first').html('<%= @active_currency %>')
      $('.twd').attr('onmouseover', `currency_dropper('<%= @active_currency %>')`)
      $('.twd img').attr('src', '<%= @assets_path %><%= @active_flag %>.svg')
      $('.twd span:first').html('<%= @active_currency %>')
      $('.sCurrency').attr('data-wallet', '<%= @active_currency %>')
  
      function goToPayChoice(){
          window.location.href=`<%= root_url %>deposit/<%= @platform %>/<%= @level %>/<%= @account %>/${$('.tu-amount').val()}/<%= @active_currency %>/${$('.twd').attr('data-currency').toUpperCase()}`
      }
  
      function currency_dropper(origin) {
            $('.tu-currency-drop').show()
            $('.tu-currency-drop').css('display', 'flex')
            $('.tu-currency-drop input').on('click', () => { return false; })
            $('.main-content').on('click', () => { $('.tu-currency-drop').hide() })
          }
  
  
      function change_tu_currency(origin, recepient, currency, flag) {
            topup_currency = recepient
            $('.tu-bottom-breakdown').css('display', 'none')
            if (origin !== recepient) {
                $('.tu-bottom-breakdown').css('display', 'flex')
                get_conversion(origin, recepient, topup_amount)
            }
            $('.twd').attr('data-currency', recepient)
            $('.twd img').attr('src', flag)
            $('.twd span:first').html(currency)
            $('.tu-currency-drop').hide()
            $('.main-content').on('click', () => { $('.tu-currency-drop').hide() })
        }
</script>
