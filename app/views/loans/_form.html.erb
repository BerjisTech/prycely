<%= form_with(model: loan) do |form| %>
  <% if loan.errors.any? %>
    <div id="error_explanation d-flex flex-column align-items-start justify-content-start">
      <div class="alert alert-warning"><%= pluralize(loan.errors.count, "error") %> prohibited this loan from being saved:</div>
      <% loan.errors.each do |error| %>
        <div class="alert alert-danger"><%= error.full_message %></div>
      <% end %>
    </div>
  <% end %>
  <div class="row">
    <%= form.hidden_field :group_id, value: session[:current_group] %>
    <%= form.hidden_field :created_by, value: current_user.id %>
    <%= form.hidden_field :date_paid %>
    <%= form.hidden_field :amount_due %>
    <%= form.hidden_field :status %>
    <%= form.hidden_field :interest %>
    <%= form.hidden_field :guarantors, class: "guarantor_input" %>
    <%= form.hidden_field :date_due %>

    <div class="col-sm-6">
      <div class="field form-floating my-2">
        <%= select_tag("loan[user_id]", options_from_collection_for_select(Member.for_group(@group.id), :user_id, :full_names), { :class => "user_field form-control", :placeholder => "Placeholder", prompt: "Giving Loan to?", required: "required" }) %>
        <%= form.label 'Member' %>
      </div>

      <div class="field form-floating my-2">
        <%= form.number_field :amount, class: "form-control", placeholder: "Placeholder", required: "required" %>
        <%= form.label "Amount in #{Money::Currency.find(@group.currency).name}s (#{Money::Currency.find(@group.currency).symbol})" %>
      </div>

      <div class="field form-floating my-2 hidden loan_category_field">
        <%= select_tag("loan[loan_type]", options_from_collection_for_select(Loancategory.where(group_id: @group.id), :id, :name), { :class => "form-control loan_category_select", :placeholder => "Placeholder", prompt: "Loan Type", required: "required" }) %>
        <%= form.label :loan_type %>
      </div>

      <div class="field form-floating my-2 hidden guarantor_field">
        <%= select_tag("guarantor_select", options_from_collection_for_select(Member.for_group(@group.id), :user_id, :full_names), { :class => "guarantor_select form-control", :placeholder => "Placeholder", prompt: "Select Guarantors", required: "required", onclick: "add_gurantor($(this).val())" }) %>
        <%= form.label :guarantors %>
      </div>

      <div class="guarantor_list_block my-2">
      </div>
    </div>
    <div class="col-sm-6">
      <div class="field form-floating my-2">
        <input type="date" name="loan[date_granted]" id="loan[date_granted]" class="form-control" placeholder="placeholder">
        <%= form.label :date_granted %>
      </div>

      <div class="field form-group my-2">
        <%= form.label :requirements %>
        <%= form.rich_text_area :requirements, class: "form-control", placeholder: "Placeholder" %>
      </div>
    </div>

    <div class="actions">
      <%= form.submit 'Create Loan', class: "btn btn-primary my-2", disabled: "true" %>
    </div>
  </div>
<% end %>

<script>
  let guarantors = $('[name="loan[guarantors]"]')
  
  $('.user_field').on('change', (e) => {
    if ($(e.target).val() != ""){
      $('.loan_category_field').removeClass('hidden')
    }
    else{
      $('.loan_category_field').addClass('hidden')
    }
  })
  
  $('.loan_category_select').on('change', (e) => {
    if ($(e.target).val() != ""){
      $('.guarantor_field').removeClass('hidden')
    }
    else{
      $('.guarantor_field').addClass('hidden')
    }
  })
  
  function own_gurantor(guarantors, user_id){
    $.ajax({
      url: `/own_guarantor/${guarantors}/${user_id}`,
      method: 'GET',
      success: (success) => {
        if (success == 0)
          guarantor_limit(guarantors)
  
        if (success == 1)
          alert('Not Ok')
      },
      error: (success) => {
        alert('Very not Ok')
      }
    })
  }
  
  function guarantor_limit(guarantors){
    let loan_category = $('.loan_category_select').val()
    guarantor_list = guarantors.split(',')
    let gc = 0
    if (guarantor_list[0] != '')
      gc = guarantor_list.length

    $.ajax({
      url: `/guarantor_limit/${gc}/${loan_category}`,
      method: 'GET',
      success: (response) => {
        if (response.status == 'success'){
          $('[type="submit"]').prop('disabled', false)
          alert(response.message)
        }
  
        if (response.status == 'error'){
          $('[type="submit"]').prop('disabled', true)
          alert(response.message)
        }
      },
      error: (error) => {
        console.log(error)
        alert('Very not Ok')
      }
    })
  }
  
  function add_gurantor(id){
    let current_guarantors = guarantors.val()
  
    let name = $(`option[value='${id}']`).text().replace(id, '')
  
    if (!current_guarantors.includes(id)){
  
      if (current_guarantors == ''){
        guarantors.val(id)
      }else{
        guarantors.val(`${current_guarantors},${id}`)
      }
  
      $('.guarantor_list_block').append(`
            <span class="guarantor_span guarantor_${id}">
              <span>${name} <em class="material-icons" onclick="remove_guarantor('${id}')">cancel</em></span>
            </span>
          `)
      own_gurantor(guarantors.val(), $('.user_field').val())
    }
  }
  
  function remove_guarantor(id){
    let current_guarantors = guarantors.val()
    let new_guarantor_list = current_guarantors
  
    new_guarantor_list = current_guarantors.replace(`,${id},`, '').replace(`,${id}`, '').replace(`${id},`, '').replace(`${id}`, '').replace(`,,`, '')
  
    guarantors.val(new_guarantor_list)
  
    $(`.guarantor_${id}`).remove()
    if (guarantors.val() == ''){
      guarantor_limit('')
    } else {
      own_gurantor(guarantors.val(), $('.user_field').val())
    }
  }
</script>
