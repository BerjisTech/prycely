<%= form_with(model: loan) do |form| %>
  <% if loan.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(loan.errors.count, "error") %> prohibited this loan from being saved:</h2>

      <ul>
        <% loan.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field form-group col-sm-12">
    <%= form.label :group_id %>
    <%= form.number_field :group_id %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :created_by %>
    <%= form.number_field :created_by %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :user_id %>
    <%= form.number_field :user_id %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :amount %>
    <%= form.text_field :amount %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :loan_type %>
    <%= form.number_field :loan_type %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :amount_due %>
    <%= form.text_field :amount_due %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :interest %>
    <%= form.number_field :interest %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :status %>
    <%= form.number_field :status %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :guarantors %>
    <%= form.text_area :guarantors %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :date_granted %>
    <%= form.datetime_select :date_granted %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :date_due %>
    <%= form.datetime_select :date_due %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :date_paid %>
    <%= form.datetime_select :date_paid %>
  </div>

  <div class="field form-group col-sm-12">
    <%= form.label :requirements %>
    <%= form.text_area :requirements %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
