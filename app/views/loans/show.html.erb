<!--p id="notice"><%= notice %></p-->
<% loan_category = Loancategory.find(@loan.loan_type) %>
<div class="row mt-5">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="d-flex whole-width align-items-center justify-content-between">
      <span class="fs-3 my-3 py-3"></span>
      <% if @loan.user_id == current_user.id || Member.is_manager(current_user.id, @loan.group_id) %>
        <div>
          <%= link_to 'Make Payment', pay_loan_path(@loan.id), class: "btn btn-primary px-2 make_loan_payment_btn" %>
          <%= link_to 'Print Report', new_loan_path, class: "btn btn-primary px-2" %>
        </div>
      <% end %>
    </div>
    <div class="row bg-white shadow border rounded">
      <div class="col-sm-3 border-end">
        <div class="d-flex flex-column align-items-start justify-content-start">
          <span class="fs-3 my-2">
            <%= link_to loan_category.name, @loan.loan_type %>
          </span>

          <span class="my-2">
            <% if current_user.id != @loan.user_id %>
              <%= link_to Account.full_names(@loan.user_id), account_path(Account.find_by(user_id: @loan.user_id).id) %>
            <% end %> Loan borrowed from <%= link_to Group.find(@loan.group_id).name, group_path(@loan.group_id) %>
            of <%= @loan.created_at.strftime("#{@loan.created_at.day.ordinalize} %b, %Y") %>
            <% if @loan.date_granted.present? %>
              and granted on <%= @loan.date_granted.strftime("#{@loan.date_granted.day.ordinalize} %b, %Y") %>
            <% end %>
            to be paid fully by <%= @loan.date_due.strftime("#{@loan.date_due.day.ordinalize} %b, %Y") %> on a <%= loan_category.interest %>% <%= loan_category.interest_rule %>
          </span>

          <span class="my-2">
            <strong>Interest:</strong>
            <%= loan_category.interest %>% <%= loan_category.interest_rule %>
          </span>

          <span class="d-flex flex-column my-2">
            <strong>Guarantors:</strong>
            <% Loan.guarantors(@loan.guarantors).map do |guarantor| %>
              <%= link_to Account.full_names(guarantor), Account.find_by(user_id: guarantor) %>
            <% end %>
          </span>

          <span class="my-2">
            <strong>Requirements:</strong>
            <%= @loan.requirements %>
          </span>

          <span class="my-2">
            <% if Member.is_manager(current_user.id, @group.id) && current_user.id != @loan.user_id %>
              <%= link_to "Edit", edit_loan_path(@loan) %>
            <% end %>
          </span>
        </div>
      </div>
      <div class="col-sm-9 border-start">
        <div class="row" style="background: #F1F1F1;">
          <div class="col-sm-3 border-end">
            <div class="d-flex align-items-center justify-content-center whole-width">
              <span class="my-3">
                <span class="fs-4"><%= Loan.status(@loan.status)%></span><br />
                <small>Status</small>
              </span>
            </div>
          </div>
          <div class="col-sm-3 border-end">
            <div class="d-flex align-items-center justify-content-center whole-width">
              <span class="my-3">
                <span class="fs-4"><%= number_with_precision(@loan.amount, precision: 2, delimiter: ",") %></span><br />
                <small>Amount taken</small>
              </span>
            </div>
          </div>
          <div class="col-sm-3 border-end">
            <div class="d-flex align-items-center justify-content-center whole-width">
              <span class="my-3">
                <span class="fs-4"><%= number_with_precision(@loan.amount_paid, precision: 2, delimiter: ",") %></span><br />
                <small>Amount paid</small>
              </span>
            </div>
          </div>
          <div class="col-sm-3">
            <div class="d-flex align-items-center justify-content-center whole-width">
              <span class="my-3">
                <span class="fs-4"><%= number_with_precision(@loan.amount_due, precision: 2, delimiter: ",") %></span><br />
                <small>Amount due</small>
              </span>
            </div>
          </div>
        </div>
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Amount</td>
              <th>Balance</td>
              <th>Date</td>
            </tr>
          </thead>
          <tbody>
            <% @loan_payments.map do |loan_payment| %>
              <tr>
                <th><%= number_with_precision(loan_payment.amount, precision: 2, delimiter: ",")%></td>
                <th><%= number_with_precision(loan_payment.amount, precision: 2, delimiter: ",")%></td>
                <th><%= loan_payment.created_at.strftime("#{loan_payment.created_at.day.ordinalize} %b, %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>
