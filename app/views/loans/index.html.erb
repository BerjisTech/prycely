<!--p id="notice"><%= notice %></p-->

<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="d-flex full-width align-items-center justify-content-between">
      <span class="fs-3 my-3 py-3">My Loans</span>
      <% if Member.is_manager(current_user.id, @group.id) %>
        <div>
          <%= link_to 'Request New Loan', new_loan_path, class: "btn btn-primary px-2" %>
        </div>
      <% end %>
    </div>
    <div class="bg-white shadow border rounded">
      <% if @loans.present? %>
        <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
          <span></span>
          <div>
            <input type="search" placeholder="Search for loans by date, amount, balance" class="form-control">
          </div>
        </div>
        <div class="group_projects">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Loan</th>
                <th>Amount</th>
                <th>Borrowed from</th>
                <th>Interest (current)</th>
                <th>Amount Due</th>
                <th>Status</th>
                <th>Guarantors</th>
                <th>Borrowed On</th>
                <td></td>
              </tr>
            </thead>
            <tbody>
              <% @loans.map do |loan| %>
                <% loan_category = Loancategory.find(loan.loan_type) %>
                <% group = Group.find(loan.group_id) %>
                <tr>
                  <td>
                    <%= link_to loan_category.name.humanize, loancategory_path(loan.loan_type) %>
                  </td>
                  <td>
                    <%= number_with_precision(loan.amount, precision: 2, delimiter: ",") %>
                  </td>
                  <td>
                    <span class="fw-bold">
                      <%= link_to group.name, group_path(loan.group_id) %>
                    </span>
                  </td>
                  <td><%= loan.interest %> (<%= loan_category.interest %>%)</td>
                  <td>
                    <%= number_with_precision(loan.amount_due, precision: 2, delimiter: ",") %>
                  </td>
                  <td>
                    <%= Loan.status(loan.status) %>
                  </td>
                  <td class="guarantor_list_block">
                    <% Loan.guarantors(loan.guarantors).map do |guarantor| %>
                      <span class="guarantor_span">
                        <span class="p-1"><%= Account.full_names(guarantor)%></span>
                      </span>
                    <% end %>
                  </td>
                  <td>
                    <%= loan.created_at.strftime("#{loan.created_at.day.ordinalize} %b, %Y") %>
                  </td>
                  <td>
                    <%= link_to 'View', loan_path(loan.id) %>
                    <% if Member.is_manager(current_user.id, @group.id) && loan.user_id != current_user.id %>
                      <% if !LoanApproval.i_approved(loan.id, current_user.id, loan.loan_type) %>
                        <a class="material-icons px-3 l_<%= loan.id %> l_approval" loan_manager="<%= current_user.id %>" loan_approval_path="<%= i_approve_path %>" loan_id="<%= loan.id %>">check</a>
                      <% end %>
                      <% if LoanApproval.i_approved(loan.id, current_user.id, loan.loan_type) %>
                        <a class="material-icons text-danger px-3 l_<%= loan.id %> l_approval" loan_manager="<%= current_user.id %>" loan_approval_path="<%= i_disapprove_path %>" loan_id="<%= loan.id %>">cancel</a>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

        </div>
      <% else %>
        <div class="m-4 p-4 d-flex align-items-center justify-content-center flex-column">
          <img src="https://assets.prycely.com/depositphotos_423476202-stock-illustration-businessmen-unlighted-light-bulb-concept.jpg" style="width: 400px;" />
          You haven't requested any loans yet
          <%= link_to 'Request a loan', new_loan_path %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-sm-1"></div>
</div>
